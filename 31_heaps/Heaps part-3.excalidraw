      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bri",
      "roundness": null,
      "seed": 1597583842,
      "version": 432,
      "versionNonce": 1157370524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787408769750,
      "link": null,
      "locked": false,
      "text": "MinHeap<int>minHeap;\n\nint index = 0;\nfor(int i = 0 ; i < n ; i++){\n    minHeap.push(nums[i]);\n    if(minHeap.size()>k){\n        nums[index++]=minHeap.top();// min element to its correct index\n        minHeap.pop();\n    }\n}\n\nwhile(!minHeap.empty()){\n    nums[index++]=minHeap.top();\n    minHeap.pop();\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MinHeap<int>minHeap;\n\nint index = 0;\nfor(int i = 0 ; i < n ; i++){\n    minHeap.push(nums[i]);\n    if(minHeap.size()>k){\n        nums[index++]=minHeap.top();// min element to its correct index\n        minHeap.pop();\n    }\n}\n\nwhile(!minHeap.empty()){\n    nums[index++]=minHeap.top();\n    minHeap.pop();\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
