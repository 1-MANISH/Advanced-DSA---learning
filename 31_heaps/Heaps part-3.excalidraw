      "text": "[_,_,_,_,_] = n = 5 (odd)  ===> median = arr[(n/2)]\n[_,_,_,_]   = n = 4 (even) ===> median = (arr[(n-1)/2]+arr[n/2])/2",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[_,_,_,_,_] = n = 5 (odd)  ===> median = arr[(n/2)]\n[_,_,_,_]   = n = 4 (even) ===> median = (arr[(n-1)/2]+arr[n/2])/2",
      "autoResize": true,
      "lineHeight": 1.25
