      "text": "as n = 5*10^5\n\nsort TC = O(n*log(n))",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "as n = 5*10^5\n\nsort TC = O(n*log(n))",
      "autoResize": true,
