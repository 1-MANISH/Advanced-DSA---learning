    {
      "id": "h06aOtuNgrGTnX5s_yGKU",
      "type": "text",
      "x": 466,
      "y": 5028.5,
      "width": 781,
      "height": 375,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
