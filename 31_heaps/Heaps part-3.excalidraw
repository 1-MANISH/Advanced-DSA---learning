    {
      "id": "Y9DaSD-alrynKZXn1sNgZ",
      "type": "text",
      "x": 479,
      "y": 31991.5,
      "width": 508.1997985839844,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0DG",
      "roundness": null,
      "seed": 208871716,
      "version": 218,
      "versionNonce": 1794648612,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787408769754,
      "link": null,
      "locked": false,
      "text": "MaxHap heap;\n\nfor(auto &ele:arr) heap.push(ele)\n\nvector<int>ans(n);\nfor(int i = n-1 ; i>=0 ;i--){\n    ans[i]=heap.getMax();\n    heap.removeMax();\n}\n\ncout << ans;",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MaxHap heap;\n\nfor(auto &ele:arr) heap.push(ele)\n\nvector<int>ans(n);\nfor(int i = n-1 ; i>=0 ;i--){\n    ans[i]=heap.getMax();\n    heap.removeMax();\n}\n\ncout << ans;",
      "autoResize": true,
      "lineHeight": 1.25
    },
