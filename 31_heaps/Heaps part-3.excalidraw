      "isDeleted": false,
      "boundElements": [],
      "updated": 1787408769751,
      "link": null,
      "locked": false,
      "text": "class KthLargest{\n    int k;\n    MinHeap<int>minHeap;//minHeap\n    public:\n        KthLarget(int k,vector<int>scores){\n            this->k=k;\n            for(auto &score:scores){\n                minHeap.push(score);\n                if(minHeap.size()>k){\n                    minHeap.pop();\n                }\n            }\n        }\n        int add(int newScore){\n            minHeap.push(newScore);\n            while(minHeap.size()>k)minHeap.pop()\n            return minHeap.top();\n        }\n};",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class KthLargest{\n    int k;\n    MinHeap<int>minHeap;//minHeap\n    public:\n        KthLarget(int k,vector<int>scores){\n            this->k=k;\n            for(auto &score:scores){\n                minHeap.push(score);\n                if(minHeap.size()>k){\n                    minHeap.pop();\n                }\n            }\n        }\n        int add(int newScore){\n            minHeap.push(newScore);\n            while(minHeap.size()>k)minHeap.pop()\n            return minHeap.top();\n        }\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
