      "isDeleted": false,
      "boundElements": null,
      "updated": 1787408769751,
      "link": null,
      "locked": false,
      "text": "n = 10^5\neach time sort - 10^5 * 10^1 => 10^6\n\nso Tc =10^5 * 10^6 => 10^11",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n = 10^5\neach time sort - 10^5 * 10^1 => 10^6\n\nso Tc =10^5 * 10^6 => 10^11",
      "autoResize": true,
      "lineHeight": 1.25
    },
