      "updated": 1787408769753,
      "link": null,
      "locked": false,
      "text": "add\n    maxHeap.push(x) \n    min(mxHeap.top())\n    maxHeap.pop()\n\n    if(maxHeap.size<minHeap){\n        maxHeap.push(minHeap.top())\n        minHeap.pop();\n    }\n\nfinMedian\n    if(maxHeap.size()>minHeaps.size()) return maxHeap.top();\n\n    else return 0.5 * (double) (maxHeap.top()*minHeap.top());\n    ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "add\n    maxHeap.push(x) \n    min(mxHeap.top())\n    maxHeap.pop()\n\n    if(maxHeap.size<minHeap){\n        maxHeap.push(minHeap.top())\n        minHeap.pop();\n    }\n\nfinMedian\n    if(maxHeap.size()>minHeaps.size()) return maxHeap.top();\n\n    else return 0.5 * (double) (maxHeap.top()*minHeap.top());\n    ",
      "autoResize": true,
      "lineHeight": 1.25
