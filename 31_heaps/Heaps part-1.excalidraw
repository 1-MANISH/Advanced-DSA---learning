      "boundElements": null,
      "updated": 1787156624439,
      "link": null,
      "locked": false,
      "text": "bool isMaxHeap(vector<int>&arr){\n\n    for (int  i = 0 ; 2*i+2 < n ;i++){\n        int x = arr[i];\n        int y = arr[2*i+1];\n        int z = arr[2*i+2];\n        if(x >= y and x >= z)continue;\n        else return false;\n    }\n    return true;\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool isMaxHeap(vector<int>&arr){\n\n    for (int  i = 0 ; 2*i+2 < n ;i++){\n        int x = arr[i];\n        int y = arr[2*i+1];\n        int z = arr[2*i+2];\n        if(x >= y and x >= z)continue;\n        else return false;\n    }\n    return true;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
