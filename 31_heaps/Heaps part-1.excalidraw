      "link": null,
      "locked": false,
      "text": "for i th node\n\nparent = (i-1)/2\n\nleft child = 2*i + 1\n\nright child = 2*i + 2",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for i th node\n\nparent = (i-1)/2\n\nleft child = 2*i + 1\n\nright child = 2*i + 2",
