    {
      "id": "dWgWE5kunfU8zE1h3bhq9",
      "type": "text",
      "x": 393.0819669451032,
      "y": 26493.5,
      "width": 514.7996826171875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
