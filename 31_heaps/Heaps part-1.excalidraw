      "isDeleted": false,
      "boundElements": null,
      "updated": 1787157154448,
      "link": null,
      "locked": false,
      "text": "Implement our own Max heap",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implement our own Max heap",
      "autoResize": true,
