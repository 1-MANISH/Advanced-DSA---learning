      "versionNonce": 177676834,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787211680353,
      "link": null,
      "locked": false,
      "text": "K = 1 ------ 9-1 => 8\nK = 2 ------ 9-2 => 7\nK = 3 ------ 9-3 => 6\nK = 4 ------ 9-4 => 5\nK = 5 ------ 9-5 => 4\nK = 6 ------ 9-6 => 3\nK = 7 ------ 9-7 => 2\nK = 8 ------ 9-8 => 1\nK = 9 ------ 9-9 => 0\n\nkth larget ====> N-K element",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "K = 1 ------ 9-1 => 8\nK = 2 ------ 9-2 => 7\nK = 3 ------ 9-3 => 6\nK = 4 ------ 9-4 => 5\nK = 5 ------ 9-5 => 4\nK = 6 ------ 9-6 => 3\nK = 7 ------ 9-7 => 2\nK = 8 ------ 9-8 => 1\nK = 9 ------ 9-9 => 0\n\nkth larget ====> N-K element",
      "autoResize": true,
      "lineHeight": 1.25
    },
