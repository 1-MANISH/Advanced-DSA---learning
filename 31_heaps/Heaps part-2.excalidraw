      "isDeleted": true,
      "boundElements": [],
      "updated": 1787210500559,
      "link": null,
      "locked": false,
      "text": "bool isMaxHeap(vector<int>&arr){\n\n    for (int  i = 0 ; i < n ;i++){\n        int x = arr[i];\n        int y = arr[2*i+1];\n        int z = arr[2*i+2];\n        if(y<n && y>x)return false;\n        if(z<n && z>x)return false;\n    }\n    return true;\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool isMaxHeap(vector<int>&arr){\n\n    for (int  i = 0 ; i < n ;i++){\n        int x = arr[i];\n        int y = arr[2*i+1];\n        int z = arr[2*i+2];\n        if(y<n && y>x)return false;\n        if(z<n && z>x)return false;\n    }\n    return true;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
