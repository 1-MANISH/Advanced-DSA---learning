    {
      "id": "2tkWlg-kfjpiTm9BDRM7i",
      "type": "text",
      "x": 474.0819669451032,
      "y": 26657.36666666667,
      "width": 659.621942138672,
      "height": 954.0000000000007,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbG",
      "roundness": null,
      "seed": 282948703,
      "version": 2013,
      "versionNonce": 1380846050,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787210500559,
      "link": null,
      "locked": false,
      "text": "class MaxHeap{\n    vector<int>arr;//[] ->   [ 18 , 7 , 6 , 5 , 4 , 1 , 2 ]\n    public:\n    void insert(x)\n    {\n        arr.push_back(x);\n        int eleIndex = arr.size()-1;\n        int parentIndex = (eleIndex-1)/2;\n        while(parentIndex >=0 && x > arr[parentIndex]){\n            swap(arr[parentIndex],arr[eleIndex]);\n            eleIndex=parentIndex;\n            parentIndex=(eleIndex-1)/2;\n        }\n    }\n    \n    int getMax(){\n        return size()==0 ? -1 : arr[0];\n    }\n\n    void removeMax(){\n        if(size()==0)return;\n        swap(arr[0],arr[arr.size()-1]);//swap\n        arr.pop_back();\n        int n = arr.size();\n        int element_index = 0; // place at right position\n        while(element_index < n){\n            int l_c_index = 2*element_index+1;\n            int r_c_index = 2*element_index+2;\n            if(l_c_index>=n)break;\n            int max_child_index = l_c_index;\n            if(r_c_index<n && arr[max_child_index]>arr[r_c_index])\n                max_child_index=r_c_index;\n            if(arr[element_index]>=arr[max_child_index])break;\n            swap(arr[element_index],arr[max_child_index ]);\n            element_index=max_child_index;\n        } \n    }\n    \n    int size(){\n        return arr.size();\n    }\n};",
      "fontSize": 18.171428571428585,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class MaxHeap{\n    vector<int>arr;//[] ->   [ 18 , 7 , 6 , 5 , 4 , 1 , 2 ]\n    public:\n    void insert(x)\n    {\n        arr.push_back(x);\n        int eleIndex = arr.size()-1;\n        int parentIndex = (eleIndex-1)/2;\n        while(parentIndex >=0 && x > arr[parentIndex]){\n            swap(arr[parentIndex],arr[eleIndex]);\n            eleIndex=parentIndex;\n            parentIndex=(eleIndex-1)/2;\n        }\n    }\n    \n    int getMax(){\n        return size()==0 ? -1 : arr[0];\n    }\n\n    void removeMax(){\n        if(size()==0)return;\n        swap(arr[0],arr[arr.size()-1]);//swap\n        arr.pop_back();\n        int n = arr.size();\n        int element_index = 0; // place at right position\n        while(element_index < n){\n            int l_c_index = 2*element_index+1;\n            int r_c_index = 2*element_index+2;\n            if(l_c_index>=n)break;\n            int max_child_index = l_c_index;\n            if(r_c_index<n && arr[max_child_index]>arr[r_c_index])\n                max_child_index=r_c_index;\n            if(arr[element_index]>=arr[max_child_index])break;\n            swap(arr[element_index],arr[max_child_index ]);\n            element_index=max_child_index;\n        } \n    }\n    \n    int size(){\n        return arr.size();\n    }\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
