      "updated": 1792691283421,
      "created": 1792691144226,
      "link": null,
      "locked": false,
      "text": "void dfs(int start,vector<int>adjList[]):\n    \n    print start\n\n    mark visited[start]=true\n\n    for adjNode of adjList[start]:\n\n        if !visited[adjNode]:\n        \n            dfs(adjNode,adjList)\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void dfs(int start,vector<int>adjList[]):\n    \n    print start\n\n    mark visited[start]=true\n\n    for adjNode of adjList[start]:\n\n        if !visited[adjNode]:\n        \n            dfs(adjNode,adjList)\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
