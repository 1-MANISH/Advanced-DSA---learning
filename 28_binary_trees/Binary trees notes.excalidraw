    {
      "id": "g-dFmDASZRSW1KM52duXb",
      "type": "text",
      "x": 183,
      "y": 9887.5,
      "width": 451,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c09k",
      "roundness": null,
      "seed": 1629713728,
      "version": 262,
      "versionNonce": 809680192,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784218171875,
      "link": null,
      "locked": false,
      "text": "int sumTree (TreeNode * root){\n    if(root==NULL)return 0;\n\n    int leftSum = sumTree (root->left);\n    int rightSum = sumTree (root->right);\n    int ans = root->val+leftSum+rightSum;\n    return ans;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int sumTree (TreeNode * root){\n    if(root==NULL)return 0;\n\n    int leftSum = sumTree (root->left);\n    int rightSum = sumTree (root->right);\n    int ans = root->val+leftSum+rightSum;\n    return ans;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
