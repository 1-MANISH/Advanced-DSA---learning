      "seed": 624437903,
      "version": 471,
      "versionNonce": 1671662159,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784654575072,
      "link": null,
      "locked": false,
      "text": "quque<pair<Node*,int>>q; // {node,distance}\nq.push({root,0})\n\nwhile(!q.empty()){\n\n    auto [node,distance]= q.front();\n    q.pop();\n   \n\n    mp[distacne].push_back(node)\n\n\n   if(node->left!=NULL)q.push({node->left,dist-1});\n   if(node->right!=NULL)q.push({node->right,dist+1});\n\n}",
      "fontSize": 28,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "quque<pair<Node*,int>>q; // {node,distance}\nq.push({root,0})\n\nwhile(!q.empty()){\n\n    auto [node,distance]= q.front();\n    q.pop();\n   \n\n    mp[distacne].push_back(node)\n\n\n   if(node->left!=NULL)q.push({node->left,dist-1});\n   if(node->right!=NULL)q.push({node->right,dist+1});\n\n}",
      "autoResize": true,
      "lineHeight": 1.15
    },
