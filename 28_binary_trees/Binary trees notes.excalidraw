      "updated": 1784220865336,
      "link": null,
      "locked": false,
      "text": "void levelORderTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    \n    while(q.empty()){\n        \n        int size= q.size();\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                cout << node->value << \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        cout << endl;\n\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void levelORderTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    \n    while(q.empty()){\n        \n        int size= q.size();\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                cout << node->value << \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        cout << endl;\n\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
