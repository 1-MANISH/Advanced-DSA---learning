      "originalText": "if(level is odd)\n    print left->right\n\nif level is even\n    print right ->left",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NoGltXaW7Tipo4kZTvbJu",
      "type": "text",
      "x": 389.5,
      "y": 14126.5,
      "width": 627,
      "height": 650,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0CZ",
      "roundness": null,
      "seed": 497710400,
      "version": 688,
      "versionNonce": 521721152,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784221393112,
      "link": null,
      "locked": false,
      "text": "void zigZagTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    int level=1;\n    \n    while(q.empty()){\n        \n        int size= q.size();\n        vector<int>nodes;\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                nodes.push_back(node->value);\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        level++;\n        if(level%2==0) reverse(nodes);\n        for(int &ele:nodes)cout << ele << \" \"; \n        cout << endl;\n\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void zigZagTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    int level=1;\n    \n    while(q.empty()){\n        \n        int size= q.size();\n        vector<int>nodes;\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                nodes.push_back(node->value);\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        level++;\n        if(level%2==0) reverse(nodes);\n        for(int &ele:nodes)cout << ele << \" \"; \n        cout << endl;\n\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
