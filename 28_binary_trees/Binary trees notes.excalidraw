      "updated": 1784221541675,
      "link": null,
      "locked": false,
      "text": "int heightOfTree(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    int height=0;\n    \n    while(q.empty()){\n        height++;\n        int size= q.size();\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        cout << endl;\n\n    }\n    return height;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int heightOfTree(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    int height=0;\n    \n    while(q.empty()){\n        height++;\n        int size= q.size();\n        while(size--){\n                Node* node=q.front();\n                q.pop();\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n        }\n        cout << endl;\n\n    }\n    return height;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
