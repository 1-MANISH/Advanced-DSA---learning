      "updated": 1784218267423,
      "link": null,
      "locked": false,
      "text": "int maxTree(TreeNode * root){\n    if(root==NULL)return INT_MIN;\n\n    int leftMax = maxTree(root->left);\n    int rightMax = maxTree(root->right);\n    int ans = max(root->val,leftMax,rightMax);\n    return ans;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int maxTree(TreeNode * root){\n    if(root==NULL)return INT_MIN;\n\n    int leftMax = maxTree(root->left);\n    int rightMax = maxTree(root->right);\n    int ans = max(root->val,leftMax,rightMax);\n    return ans;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
