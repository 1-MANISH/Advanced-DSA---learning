    {
      "id": "fRnToCwi-yruz7V3RS7wy",
      "type": "text",
      "x": 454.5,
      "y": 16338,
      "width": 627,
      "height": 625,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Co",
      "roundness": null,
      "seed": 33781056,
      "version": 817,
      "versionNonce": 1567383232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784221779217,
      "link": null,
      "locked": false,
      "text": "void leftView(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n  \n    while(q.empty()){\n        \n        int size= q.size();\n        int i = 0 ;\n        while(i<size){\n                Node* node=q.front();\n                q.pop();\n                if(i==0)\n                     cout << node->value<< \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n                i++\n        }\n        \n        \n\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void leftView(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n  \n    while(q.empty()){\n        \n        int size= q.size();\n        int i = 0 ;\n        while(i<size){\n                Node* node=q.front();\n                q.pop();\n                if(i==0)\n                     cout << node->value<< \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n                i++\n        }\n        \n        \n\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
