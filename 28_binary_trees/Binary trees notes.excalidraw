      "index": "c08A",
      "roundness": null,
      "seed": 158615232,
      "version": 222,
      "versionNonce": 996109632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784216449671,
      "link": null,
      "locked": false,
      "text": "void preOrder(TreeNode* root){\n    if(root==NULL) return;\n\n    cout << root << \" \";\n    preOrder(root->left);\n    proOrder(root-.right);\n}\nmain(){\n\n    preOrder(root)\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void preOrder(TreeNode* root){\n    if(root==NULL) return;\n\n    cout << root << \" \";\n    preOrder(root->left);\n    proOrder(root-.right);\n}\nmain(){\n\n    preOrder(root)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
