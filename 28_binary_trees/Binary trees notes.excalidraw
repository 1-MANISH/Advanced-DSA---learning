      "isDeleted": false,
      "boundElements": null,
      "updated": 1784218634479,
      "link": null,
      "locked": false,
      "text": "int countNodes(TreeNode* root,int x){\n\n    if(root==NULL) return 0;\n    int l_count = countNode(root->left,x)\n    int r_count = coutnNode(root->right,x)\n    int ans = l_count+r_count;\n    if(root->val==x){ans++}\n    return ans;\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int countNodes(TreeNode* root,int x){\n\n    if(root==NULL) return 0;\n    int l_count = countNode(root->left,x)\n    int r_count = coutnNode(root->right,x)\n    int ans = l_count+r_count;\n    if(root->val==x){ans++}\n    return ans;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
