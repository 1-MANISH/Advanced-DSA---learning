      "seed": 1616959168,
      "version": 331,
      "versionNonce": 1838769856,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784219900256,
      "link": null,
      "locked": false,
      "text": "void levelORderTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    \n    while(q.empty()){\n        Node* node=q.front();\n        q.pop();\n        cout << node->value << \" \";\n        if(node->left!=NULL)q.push(node->left);\n        if(node->right!=NULL)q.push(node->right);\n\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void levelORderTraversal(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n    \n    while(q.empty()){\n        Node* node=q.front();\n        q.pop();\n        cout << node->value << \" \";\n        if(node->left!=NULL)q.push(node->left);\n        if(node->right!=NULL)q.push(node->right);\n\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
