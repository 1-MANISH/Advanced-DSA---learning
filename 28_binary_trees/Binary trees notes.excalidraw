      "updated": 1784219081983,
      "link": null,
      "locked": false,
      "text": "int height(TreeNode* node){\n    if(root==NULL) return 0;\n    int l_h = height(node->left);\n    int r_h = height(node->right);\n    return 1+max(l_h,r_h);\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int height(TreeNode* node){\n    if(root==NULL) return 0;\n    int l_h = height(node->left);\n    int r_h = height(node->right);\n    return 1+max(l_h,r_h);\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
