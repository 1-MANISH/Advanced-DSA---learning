      "link": null,
      "locked": false,
      "text": "void RightView(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n  \n    while(q.empty()){\n        \n        int size= q.size();\n        int i = 0 ;\n        while(i<size){\n                Node* node=q.front();\n                q.pop();\n                if(i==size-1)\n                     cout << node->value<< \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n                i++\n        }\n        \n        \n\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void RightView(TreeNode* root){\n\n    if(root==NULL) return;\n    queue<Node*>q;\n    q.push(root)\n  \n    while(q.empty()){\n        \n        int size= q.size();\n        int i = 0 ;\n        while(i<size){\n                Node* node=q.front();\n                q.pop();\n                if(i==size-1)\n                     cout << node->value<< \" \";\n                if(node->left!=NULL)q.push(node->left);\n                if(node->right!=NULL)q.push(node->right);\n                i++\n        }\n        \n        \n\n    }\n\n}",
      "autoResize": true,
