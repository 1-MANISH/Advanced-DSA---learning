    {
      "id": "1g-Hg_52b6l5iDC_fCBPm",
      "type": "text",
      "x": 510,
      "y": 4357.5,
      "width": 588.65966796875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01P",
      "roundness": null,
      "seed": 1216700165,
      "version": 275,
      "versionNonce": 1924945707,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785427343113,
      "link": null,
      "locked": false,
      "text": "bool search(Tree root,int target){\n    \n    if(root==NULL) return false;\n\n    if(root->val==target)return true;\n\n    if(target<root->val) return search(root->left,target);\n\n    else (target>root->val) return search(root->right,target)\n\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool search(Tree root,int target){\n    \n    if(root==NULL) return false;\n\n    if(root->val==target)return true;\n\n    if(target<root->val) return search(root->left,target);\n\n    else (target>root->val) return search(root->right,target)\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
