      "isDeleted": true,
      "boundElements": null,
      "updated": 1791814958327,
      "created": 1791477276122,
      "link": null,
      "locked": false,
      "text": "int idx = max_element(dp.begin(),dp.end())\n\nint len = dp[idx]\n\n\nvector<int>result;\n\nwhile(len > 0 ) :\n\n    if(dp[idx]==len):\n        result.push_back(arr[idx])\n        len--;\n\n    idx--\n\n\nreverse(result)\n\nprint (result)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int idx = max_element(dp.begin(),dp.end())\n\nint len = dp[idx]\n\n\nvector<int>result;\n\nwhile(len > 0 ) :\n\n    if(dp[idx]==len):\n        result.push_back(arr[idx])\n        len--;\n\n    idx--\n\n\nreverse(result)\n\nprint (result)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
