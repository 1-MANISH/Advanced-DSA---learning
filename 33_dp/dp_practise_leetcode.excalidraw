    {
      "id": "hkq6NGq2dgyDoXYWF1OZ6",
      "type": "text",
      "x": 246,
      "y": 9223.5,
      "width": 749.3998718261719,
      "height": 650,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bda",
      "roundness": null,
      "seed": 654329695,
      "version": 454,
      "versionNonce": 978135449,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791814958327,
      "created": 1791478356208,
      "link": null,
      "locked": false,
      "text": "vector<int>count\nfor(int i = 0 ; i < n ; i++):\n\n    if(dp[i]=1):\n\n        count[i]=1;\n\n    for(int j = i-1 ; j >=0 ; j--) :\n\n        if(arr[j] < arr[i] and dp[j]==dp[i-1] ):\n\n            count[i] = (count[i] + count[j])\n\n\nint len = *max_element(dp)\n\nint ans = 0 \n\nfor(int i = 0 ; i < n  ; i++) :\n\n    if(dp[i]==len) :\n\n        ans += count[i]   \n\n\ncout << ans;       ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "vector<int>count\nfor(int i = 0 ; i < n ; i++):\n\n    if(dp[i]=1):\n\n        count[i]=1;\n\n    for(int j = i-1 ; j >=0 ; j--) :\n\n        if(arr[j] < arr[i] and dp[j]==dp[i-1] ):\n\n            count[i] = (count[i] + count[j])\n\n\nint len = *max_element(dp)\n\nint ans = 0 \n\nfor(int i = 0 ; i < n  ; i++) :\n\n    if(dp[i]==len) :\n\n        ans += count[i]   \n\n\ncout << ans;       ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
