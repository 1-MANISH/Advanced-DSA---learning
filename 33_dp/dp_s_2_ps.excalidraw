    {
      "id": "6iVe_Rn4ybAS-tZM1dgHI",
      "type": "text",
      "x": -573,
      "y": 16586.5,
      "width": 583,
      "height": 400,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c43D",
      "roundness": null,
      "seed": 1797520828,
      "version": 439,
      "versionNonce": 1609869956,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789143198481,
      "link": null,
      "locked": false,
      "text": "int f(int index,int currentSum ):\n    \n    if(index>=n):\n        return currentSum==target\n\n    if(currentSum>target)\n        return 0; // as all number are positives only\n\n    // take it\n    int a1 = f(index+1,currentSum+arr[index])\n\n\n    // not take it\n    int a2 = f(index+1,currentSum)\n\n    return a1+a2",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int index,int currentSum ):\n    \n    if(index>=n):\n        return currentSum==target\n\n    if(currentSum>target)\n        return 0; // as all number are positives only\n\n    // take it\n    int a1 = f(index+1,currentSum+arr[index])\n\n\n    // not take it\n    int a2 = f(index+1,currentSum)\n\n    return a1+a2",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
