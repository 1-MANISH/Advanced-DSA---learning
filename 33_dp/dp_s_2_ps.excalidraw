      "versionNonce": 433904516,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789294295252,
      "link": null,
      "locked": false,
      "text": "f (int index ,  int currentW ):\n    \n    if(index>=n) :\n        return 0;\n    \n    int a1 = 0\n    if ( currentW+weight[index]<=W ) :\n        int a1 = cost[index] + f(index,currentW+weight[index]\n\n    int a2 = f(index,currentW)\n\n\n    return max(a1,a2)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f (int index ,  int currentW ):\n    \n    if(index>=n) :\n        return 0;\n    \n    int a1 = 0\n    if ( currentW+weight[index]<=W ) :\n        int a1 = cost[index] + f(index,currentW+weight[index]\n\n    int a2 = f(index,currentW)\n\n\n    return max(a1,a2)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
