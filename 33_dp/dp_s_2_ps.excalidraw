    {
      "id": "FPSqV_Ws25MvHZhLG4OOv",
      "type": "text",
      "x": -547,
      "y": 12962.5,
      "width": 605,
      "height": 375,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
