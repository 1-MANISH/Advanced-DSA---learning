    {
      "id": "uxoh7KwU3VD4U2UhL4Y7T",
      "type": "text",
      "x": 441,
      "y": 8726.5,
      "width": 708.3997192382812,
      "height": 420,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
