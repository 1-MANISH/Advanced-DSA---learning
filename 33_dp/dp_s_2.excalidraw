      "updated": 1789487907966,
      "created": 1789487847160,
      "link": null,
      "locked": false,
      "text": "ans = 0\n\nmx = prices[n-1]\n\n\nfor(int i =  n-2 ; i >=0 ; i-- ) :\n\n\n    ans = max(ans,mx-price[i])\n\n    mx = max(mx,prices[i])\n\nprint(ans)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ans = 0\n\nmx = prices[n-1]\n\n\nfor(int i =  n-2 ; i >=0 ; i-- ) :\n\n\n    ans = max(ans,mx-price[i])\n\n    mx = max(mx,prices[i])\n\nprint(ans)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
