      "updated": 1789485794739,
      "created": 1789376264715,
      "link": null,
      "locked": false,
      "text": "we can rod into any number of pieces(including no cut) .  each prices have integer length\nthe sum of all length =  n\n\nmaximize total value obtainable",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we can rod into any number of pieces(including no cut) .  each prices have integer length\nthe sum of all length =  n\n\nmaximize total value obtainable",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
