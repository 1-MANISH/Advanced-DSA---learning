    {
      "id": "mdGtWA3NbtaTdZtTJm3pW",
      "type": "text",
      "x": 1515,
      "y": 7753.5,
      "width": 319,
      "height": 475,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3xh",
      "roundness": null,
      "seed": 1496616124,
      "version": 327,
      "versionNonce": 1852076096,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789485794736,
      "link": null,
      "locked": false,
      "text": "int subset[]\nint ans[]\n\nvoid f(int index,int n){\n\n    if index>=n :\n        ans.push_back(subset)\n    \n    // pick\n    subset.push(arr[index])\n    f(index+1,n)\n    subset.pop()\n\n    // not pick\n\n    f(index+1,n)\n\n    \n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int subset[]\nint ans[]\n\nvoid f(int index,int n){\n\n    if index>=n :\n        ans.push_back(subset)\n    \n    // pick\n    subset.push(arr[index])\n    f(index+1,n)\n    subset.pop()\n\n    // not pick\n\n    f(index+1,n)\n\n    \n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
