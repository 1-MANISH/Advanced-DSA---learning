    {
      "id": "FBmnPhBOR6Vnxmcz0txKa",
      "type": "text",
      "x": -499,
      "y": 23646,
      "width": 387.199462890625,
      "height": 260,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4BU",
      "roundness": null,
      "seed": 1012280964,
      "version": 349,
      "versionNonce": 334252096,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789485794738,
      "link": null,
      "locked": false,
      "text": "int f(int index,int currentSum) :\n\n    if(index>=n) :\n        int s2 = totalSum-currentSum\n        return abs(currentSum-s2)\n\n\n    int a1 = f(index+1,currentSum+arr[index]\n\n\n    int a2 = f(index+1,currentSum)\n\n    return min(a1,a2)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int index,int currentSum) :\n\n    if(index>=n) :\n        int s2 = totalSum-currentSum\n        return abs(currentSum-s2)\n\n\n    int a1 = f(index+1,currentSum+arr[index]\n\n\n    int a2 = f(index+1,currentSum)\n\n    return min(a1,a2)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
