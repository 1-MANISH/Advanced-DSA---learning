    },
    {
      "id": "yHf7U9L0IL552f63LfRlZ",
      "type": "text",
      "x": 379.3999938964844,
      "y": 19154.5,
      "width": 495,
      "height": 475,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bT7",
      "roundness": null,
      "seed": 754656991,
      "version": 385,
      "versionNonce": 2106072703,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791446964710,
      "created": 1791446727995,
      "link": null,
      "locked": false,
      "text": "vector<int>count(n,0)\nfor(int i = 0  ; i < n  ; i++):\n    if(i==0):\n        dp[i]=1\n\n    for(int j = i-1 ; j>=0 ; j--):\n        if(arr[j]<arr[i] and dp[j]==dp[i]-1):\n            count[i] = count[i] + count[j]\n   \n\nint len_lis = *max_element(dp)\n\nint ans = 0;\n\nfor(int i = 0  ; i < n ; i++) :\n    if(dp[i]==len_lis):\n        ans+=count[i]\n\ncout << ans;",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "vector<int>count(n,0)\nfor(int i = 0  ; i < n  ; i++):\n    if(i==0):\n        dp[i]=1\n\n    for(int j = i-1 ; j>=0 ; j--):\n        if(arr[j]<arr[i] and dp[j]==dp[i]-1):\n            count[i] = count[i] + count[j]\n   \n\nint len_lis = *max_element(dp)\n\nint ans = 0;\n\nfor(int i = 0  ; i < n ; i++) :\n    if(dp[i]==len_lis):\n        ans+=count[i]\n\ncout << ans;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
