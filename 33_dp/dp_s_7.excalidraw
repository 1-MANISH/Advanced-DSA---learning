    {
      "id": "jDrmedaPNdxkXWBC2YsPe",
      "type": "text",
      "x": 496,
      "y": 2341,
      "width": 550,
      "height": 750,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAN",
      "roundness": null,
      "seed": 2009339391,
      "version": 627,
      "versionNonce": 58440017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791306646300,
      "created": 1791306301109,
      "link": null,
      "locked": false,
      "text": "int N = 1e3\nint dp[N][N+1]\n\nint f (int index,int prevIndex,int A[]) :\n\n    // base case\n    if (index == A.size())\n        return 0;\n\n    if(dp[index][prevIndex+1]!=-1)\n        return dp[index][prevIndex+1];\n\n    // not take\n    int ans1 = solve(index+1,prevIndex,A)\n\n    // take- if possible\n\n    int ans2 = 0 ;\n\n    if(prevIndex==-1 or A[prevIndex] < arr[index])\n        ans2 = 1 + solve(index+1,index,A)\n\n    return dp[index][prevIndex+1] = max(ans1,ans2)\n    \n\nmain:\n    inpuit\n    fiil(dp,-1)\n\n    cout << solve(0,-1,A)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int N = 1e3\nint dp[N][N+1]\n\nint f (int index,int prevIndex,int A[]) :\n\n    // base case\n    if (index == A.size())\n        return 0;\n\n    if(dp[index][prevIndex+1]!=-1)\n        return dp[index][prevIndex+1];\n\n    // not take\n    int ans1 = solve(index+1,prevIndex,A)\n\n    // take- if possible\n\n    int ans2 = 0 ;\n\n    if(prevIndex==-1 or A[prevIndex] < arr[index])\n        ans2 = 1 + solve(index+1,index,A)\n\n    return dp[index][prevIndex+1] = max(ans1,ans2)\n    \n\nmain:\n    inpuit\n    fiil(dp,-1)\n\n    cout << solve(0,-1,A)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e0xgc1lNI8bRnrciE9x98",
      "type": "rectangle",
      "x": 447,
      "y": 2312,
      "width": 641,
      "height": 793,
