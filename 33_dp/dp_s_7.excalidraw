      "groupIds": [],
      "frameId": null,
      "index": "bCQ",
      "roundness": null,
      "seed": 1304917233,
      "version": 283,
      "versionNonce": 1095667121,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791309126179,
      "created": 1791308073069,
      "link": null,
      "locked": false,
      "text": "\nint dp[N]\n\n\nfor(int i = 0 ;  i < N ; i++ ) :\n\n    dp[i] = 1 // single element always 1\n\n    for(int j = i-1 ; j >=0 ; j--):\n\n        if A[j] < A[i]:\n            dp[i] = max(dp[i],1 + dp[j])\n\n\ncout << *max_element(dp.begin(),dp.end());\n\n        ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nint dp[N]\n\n\nfor(int i = 0 ;  i < N ; i++ ) :\n\n    dp[i] = 1 // single element always 1\n\n    for(int j = i-1 ; j >=0 ; j--):\n\n        if A[j] < A[i]:\n            dp[i] = max(dp[i],1 + dp[j])\n\n\ncout << *max_element(dp.begin(),dp.end());\n\n        ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
