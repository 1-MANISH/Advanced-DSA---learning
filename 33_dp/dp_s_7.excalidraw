    {
      "id": "rKs31Aq_KKbf16d1uYzMt",
      "type": "text",
      "x": 405.3999938964844,
      "y": 18846.5,
      "width": 812.0000000000002,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
