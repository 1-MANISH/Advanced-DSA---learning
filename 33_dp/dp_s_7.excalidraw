      "seed": 2089238993,
      "version": 404,
      "versionNonce": 1796285023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791306255473,
      "created": 1791305985025,
      "link": null,
      "locked": false,
      "text": "int f (int index,int prevIndex,int A[]) :\n\n    // base case\n    if (index == A.size())\n        return 0;\n\n    // not take\n    int ans1 = solve(index+1,prevIndex,A)\n\n    // take- if possible\n\n    int ans2 = 0 ;\n\n    if(prevIndex==-1 or A[prevIndex] < arr[index])\n        ans2 = 1 + solve(index+1,index,A)\n\n    return max(ans1,ans2)\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f (int index,int prevIndex,int A[]) :\n\n    // base case\n    if (index == A.size())\n        return 0;\n\n    // not take\n    int ans1 = solve(index+1,prevIndex,A)\n\n    // take- if possible\n\n    int ans2 = 0 ;\n\n    if(prevIndex==-1 or A[prevIndex] < arr[index])\n        ans2 = 1 + solve(index+1,index,A)\n\n    return max(ans1,ans2)\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
