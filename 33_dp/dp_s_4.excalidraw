      "seed": 2001152027,
      "version": 309,
      "versionNonce": 563265333,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524913,
      "created": 1789660904938,
      "link": null,
      "locked": false,
      "text": "solve(int i , int j ) :\n    \n    if(i==n or j==m):\n        return 0\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] :\n\n        ans = 1 + solve(i+1,j+1)\n\n    else :\n\n        ans1 = solve(i+1,j)\n\n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n    return ans\n        \n   \n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "solve(int i , int j ) :\n    \n    if(i==n or j==m):\n        return 0\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] :\n\n        ans = 1 + solve(i+1,j+1)\n\n    else :\n\n        ans1 = solve(i+1,j)\n\n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n    return ans\n        \n   \n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
