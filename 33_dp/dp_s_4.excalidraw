    {
      "id": "J9JqKiQ2ml9CF8dK7uomp",
      "type": "text",
      "x": 550,
      "y": 20223.5,
      "width": 352,
      "height": 650,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4hA",
      "roundness": null,
      "seed": 2004914741,
      "version": 404,
      "versionNonce": 671335291,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524914,
      "created": 1789665074973,
      "link": null,
      "locked": false,
      "text": "solve(i,j) :\n\n    if(i==j) :\n        return 1\n\n    if i>j :\n        return 0;\n\n    \n    if s[i] == s[j] :\n        ans = 2+solve(i+1,j-1)\n\n    else:\n        \n        // lets not take i waala\n\n        ans1 = solve(i+1,j)\n\n        // lets not take j waala\n        \n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n\n    return ans",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "solve(i,j) :\n\n    if(i==j) :\n        return 1\n\n    if i>j :\n        return 0;\n\n    \n    if s[i] == s[j] :\n        ans = 2+solve(i+1,j-1)\n\n    else:\n        \n        // lets not take i waala\n\n        ans1 = solve(i+1,j)\n\n        // lets not take j waala\n        \n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n\n    return ans",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
