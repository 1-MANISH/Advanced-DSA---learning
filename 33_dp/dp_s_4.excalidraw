    {
      "id": "4JdSxLbzH0ASflfXGYTwM",
      "type": "text",
      "x": 300,
      "y": 14954.5,
      "width": 594,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4be",
      "roundness": null,
      "seed": 160208960,
      "version": 1054,
      "versionNonce": 1254816667,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789637596731,
      "created": 1789490757312,
      "link": null,
      "locked": false,
      "text": "int ** dp\n\nint solve(int index,int transactionType ) :\n    \n    if(index==n)\n        return 0\n\n    if(dp[index][transactionType ] != -1 ) :\n        return dp[index][transactionType ]\n\n    // skip this day\n\n    ans1 = solve(index+1,event)\n\n\n    if transactionType == \"BUY\"\n        ans2 = -prices[index]+solve(index+SELL)\n    else :\n        ans2 = prices[i]+solve(index+1,BUY)\n    \n    return dp[index][transactionType ]= max(ans1,ans2)\n\nmain():\n\n    //input\n    \n    // dp[n][n] = //all -1\n    ans = solve(0,0)\n    \n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int ** dp\n\nint solve(int index,int transactionType ) :\n    \n    if(index==n)\n        return 0\n\n    if(dp[index][transactionType ] != -1 ) :\n        return dp[index][transactionType ]\n\n    // skip this day\n\n    ans1 = solve(index+1,event)\n\n\n    if transactionType == \"BUY\"\n        ans2 = -prices[index]+solve(index+SELL)\n    else :\n        ans2 = prices[i]+solve(index+1,BUY)\n    \n    return dp[index][transactionType ]= max(ans1,ans2)\n\nmain():\n\n    //input\n    \n    // dp[n][n] = //all -1\n    ans = solve(0,0)\n    \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
