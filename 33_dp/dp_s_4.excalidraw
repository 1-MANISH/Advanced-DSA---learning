      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TC  = o(max(n,m)) => o(n)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FOdSvBrI0DEreXYwJPrrh",
      "type": "text",
      "x": 330.400146484375,
      "y": 2784.5,
      "width": 418,
      "height": 325,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4cs",
      "roundness": null,
      "seed": 1669701531,
      "version": 508,
      "versionNonce": 401759035,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524913,
      "created": 1789660113198,
      "link": null,
      "locked": false,
      "text": "bool isSubsequence(string s,string t){\n    int i  = 0 ,  n = s.size()\n    int j  = 0 ,  m = t.size()\n\n    while(i<n and j < m){\n        if(s[i]==t[j]){\n            j++;\n        }\n        i++\n    }\n    return j==m;\n\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool isSubsequence(string s,string t){\n    int i  = 0 ,  n = s.size()\n    int j  = 0 ,  m = t.size()\n\n    while(i<n and j < m){\n        if(s[i]==t[j]){\n            j++;\n        }\n        i++\n    }\n    return j==m;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
