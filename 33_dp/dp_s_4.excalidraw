      "updated": 1789485794736,
      "link": null,
      "locked": false,
      "text": "bool f(int index,int currentSum) :\n\n    if(index>=n) :\n        return currentSum==target\n\n    // take it\n    bool a1 = f(index+1,currentSum+arr[index])\n\n    // not take it\n    bool a2 = f(index+1,currentSum)\n\n    return a1 or a2",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool f(int index,int currentSum) :\n\n    if(index>=n) :\n        return currentSum==target\n\n    // take it\n    bool a1 = f(index+1,currentSum+arr[index])\n\n    // not take it\n    bool a2 = f(index+1,currentSum)\n\n    return a1 or a2",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
