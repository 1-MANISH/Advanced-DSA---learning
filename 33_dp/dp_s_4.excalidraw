      "groupIds": [],
      "frameId": null,
      "index": "c4q0",
      "roundness": null,
      "seed": 432350459,
      "version": 516,
      "versionNonce": 974083637,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "1fPylXh-zLiZStCK2Cq7V",
          "type": "arrow"
        }
      ],
      "updated": 1790093140880,
      "created": 1790092757006,
      "link": null,
      "locked": false,
      "text": "int solve(int i , int j) :\n\n    // base case\n\n    if(i==s.size())\n        return m - t.size()\n\n    if(j == t.size())\n        return n - s.size()\n\n    int ans = 0 \n    if(s[i] == t[j] ) :\n        ans =  1 + solve(i+1,j+1)\n\n\n    else :\n        //pick char from s\n        int ans1 = 1 + solve(i+1,j)\n        \n        // pick char from t\n        int ans2 = 1 + solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n    return ans;\n\n\n            ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(int i , int j) :\n\n    // base case\n\n    if(i==s.size())\n        return m - t.size()\n\n    if(j == t.size())\n        return n - s.size()\n\n    int ans = 0 \n    if(s[i] == t[j] ) :\n        ans =  1 + solve(i+1,j+1)\n\n\n    else :\n        //pick char from s\n        int ans1 = 1 + solve(i+1,j)\n        \n        // pick char from t\n        int ans2 = 1 + solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n    return ans;\n\n\n            ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
