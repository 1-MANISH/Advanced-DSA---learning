    {
      "id": "pN23fv2MHunULiHHuaRkv",
      "type": "text",
      "x": 410.5,
      "y": 8400,
      "width": 385,
      "height": 925,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4qC",
      "roundness": null,
      "seed": 631185499,
      "version": 641,
      "versionNonce": 377542677,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790093129197,
      "created": 1790093099509,
      "link": null,
      "locked": false,
      "text": "int dp[N][N]\n\nint solve(int i , int j) :\n\n    // base case\n\n    if(i==s.size())\n        return m - t.size()\n\n    if(j == t.size())\n        return n - s.size()\n\n    int ans = 0 \n    if(s[i] == t[j] ) :\n        ans =  1 + solve(i+1,j+1)\n\n\n    else :\n        //pick char from s\n        int ans1 = 1 + solve(i+1,j)\n        \n        // pick char from t\n        int ans2 = 1 + solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n    return ans;\n\n\nmain :\n    // input \n    // fil(dp,-1,sizeof dp)\n\n    cout << solve(0,0)\n\n\n            ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[N][N]\n\nint solve(int i , int j) :\n\n    // base case\n\n    if(i==s.size())\n        return m - t.size()\n\n    if(j == t.size())\n        return n - s.size()\n\n    int ans = 0 \n    if(s[i] == t[j] ) :\n        ans =  1 + solve(i+1,j+1)\n\n\n    else :\n        //pick char from s\n        int ans1 = 1 + solve(i+1,j)\n        \n        // pick char from t\n        int ans2 = 1 + solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n    return ans;\n\n\nmain :\n    // input \n    // fil(dp,-1,sizeof dp)\n\n    cout << solve(0,0)\n\n\n            ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
