      "updated": 1789711524914,
      "created": 1789663790417,
      "link": null,
      "locked": false,
      "text": "int solve(i,j) :\n\n    // base case\n    if i==n :\n        return m-j // remaining part of s2(m-j\n    if j==m :\n        return n-i // remaining part of s1(n-i) \n\n    ans = 0 \n\n    if s1[i] == s2[j]:\n        ans = solve(i+1,j+1)\n\n    else :\n        // update,insert,remove - 3 options\n\n        // update\n        ans1 = 1+ solve(i+1,j+1)\n\n        // remove from s1 + insert in s2\n        ans2 = 1+solve(i+1,j)\n        \n        // remove from s2 + insert in s1\n        ans3 = 1+solve(i,j+1)\n\n        ans = min(ans1,ans2,ans3)\n\n\n    return  ans\n        \n   ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(i,j) :\n\n    // base case\n    if i==n :\n        return m-j // remaining part of s2(m-j\n    if j==m :\n        return n-i // remaining part of s1(n-i) \n\n    ans = 0 \n\n    if s1[i] == s2[j]:\n        ans = solve(i+1,j+1)\n\n    else :\n        // update,insert,remove - 3 options\n\n        // update\n        ans1 = 1+ solve(i+1,j+1)\n\n        // remove from s1 + insert in s2\n        ans2 = 1+solve(i+1,j)\n        \n        // remove from s2 + insert in s1\n        ans3 = 1+solve(i,j+1)\n\n        ans = min(ans1,ans2,ans3)\n\n\n    return  ans\n        \n   ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
