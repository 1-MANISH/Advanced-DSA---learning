    {
      "id": "y2SoLrVd8C0QkuLf-22cT",
      "type": "text",
      "x": 588,
      "y": 18497.5,
      "width": 374,
      "height": 300,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4gI",
