    {
      "id": "_jVqsSbjhSzbYleG-hO3e",
      "type": "text",
      "x": 272,
      "y": 12695.5,
      "width": 853.5988159179688,
      "height": 980,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4rc",
      "roundness": null,
      "seed": 489698587,
      "version": 1103,
      "versionNonce": 1426022267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790094406043,
      "created": 1790093642337,
      "link": null,
      "locked": false,
      "text": "const int NONE = 0;\n\nconst int NORMAL_TRX = 1;\n\nconst int SHORT_SELL_TRX = 2;\n\nint solve(int index,int transactionType) :\n    \n\n    // base case\n    if(index==prices.size())\n        return transactionType==NONE ? 0 : INT_MIN;// if started trxn done then valid\n    \n\n    ans1=ans2=ans3 = INT_MIN\n    \n    // skip this day\n    int ans1 = solve(index+1,transactionType)\n    \n    // do the possible transaction\n\n    if transactionType === NONE :\n        \n        // start a normal trx\n        ans2 = -prices[index]  + solve(index+1,NORMAL_TRX)// complete in future\n        \n        // start a short selling trx\n        ans3 = +prices[index] + solve(index+1,SHORT_SELL_TRX )// complete short selling in future\n\n    else if transactionType == NORMAL_TRX :\n        // completeing normal transaction\n        ans2 = +prices[index] + solve(index+1,NONE)\n\n    else :// SHORT_SELL_TRX \n        // completing short selling -  buy back\n        ans3 = -prices[index] + solve(index+1,NONE)\n    \n    return max(ans1,ans2,ans3)\n\n\n\nmain() :\n    // input\n\n    cout << solve(0,NONE)\n    \n        \n\n    ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const int NONE = 0;\n\nconst int NORMAL_TRX = 1;\n\nconst int SHORT_SELL_TRX = 2;\n\nint solve(int index,int transactionType) :\n    \n\n    // base case\n    if(index==prices.size())\n        return transactionType==NONE ? 0 : INT_MIN;// if started trxn done then valid\n    \n\n    ans1=ans2=ans3 = INT_MIN\n    \n    // skip this day\n    int ans1 = solve(index+1,transactionType)\n    \n    // do the possible transaction\n\n    if transactionType === NONE :\n        \n        // start a normal trx\n        ans2 = -prices[index]  + solve(index+1,NORMAL_TRX)// complete in future\n        \n        // start a short selling trx\n        ans3 = +prices[index] + solve(index+1,SHORT_SELL_TRX )// complete short selling in future\n\n    else if transactionType == NORMAL_TRX :\n        // completeing normal transaction\n        ans2 = +prices[index] + solve(index+1,NONE)\n\n    else :// SHORT_SELL_TRX \n        // completing short selling -  buy back\n        ans3 = -prices[index] + solve(index+1,NONE)\n    \n    return max(ans1,ans2,ans3)\n\n\n\nmain() :\n    // input\n\n    cout << solve(0,NONE)\n    \n        \n\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
