    {
      "id": "rWOuX0cmF5tblLEXR58uy",
      "type": "text",
      "x": 358,
      "y": 3823.5,
      "width": 319,
      "height": 475,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4o2",
      "roundness": null,
      "seed": 1041937979,
      "version": 316,
      "versionNonce": 1427158133,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790091900325,
      "created": 1790091726111,
      "link": null,
      "locked": false,
      "text": "int solve(int i,int j) :\n\n    // base case\n\n    if(j==t.size()) return 1;\n\n    if(i==s.size())\n        return 0;\n\n    // not take it\n    int ans = solve(i+1,j)\n\n    // take it\n    int ans2 = 0;\n\n    if s[i==t[j] :\n        ans2 = solve(i+1,j+1)\n\n    return ans1+ans2",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(int i,int j) :\n\n    // base case\n\n    if(j==t.size()) return 1;\n\n    if(i==s.size())\n        return 0;\n\n    // not take it\n    int ans = solve(i+1,j)\n\n    // take it\n    int ans2 = 0;\n\n    if s[i==t[j] :\n        ans2 = solve(i+1,j+1)\n\n    return ans1+ans2",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
