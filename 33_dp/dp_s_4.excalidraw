    },
    {
      "id": "9yWN9xkhHGUQheFo_CPdk",
      "type": "text",
      "x": 319,
      "y": 2043.5,
      "width": 585.19970703125,
      "height": 595,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4cm",
      "roundness": null,
      "seed": 636070299,
      "version": 389,
      "versionNonce": 165036379,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524913,
      "created": 1789659707608,
      "link": null,
      "locked": false,
      "text": "bool isSubsequence(string s,string t){\n    int i  = 0 ,  n = s.size();\n    int j  = 0 ,  m = t.size();\n\n    while(i<n and j < m){\n\n        if(s[i]==t[j]){\n            i++;\n            j++;\n        }\n        else{\n            i++;\n        }\n    }\n    return j==m;\n\n}",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool isSubsequence(string s,string t){\n    int i  = 0 ,  n = s.size();\n    int j  = 0 ,  m = t.size();\n\n    while(i<n and j < m){\n\n        if(s[i]==t[j]){\n            i++;\n            j++;\n        }\n        else{\n            i++;\n        }\n    }\n    return j==m;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
