    {
      "id": "GZQd3n3xZ9-QfMGZj_g_G",
      "type": "text",
      "x": 580,
      "y": 4081.5,
      "width": 253,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4Yu",
      "roundness": null,
      "seed": 1602345920,
      "version": 26,
      "versionNonce": 1175376373,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789637596730,
      "created": 1789487451182,
      "link": null,
      "locked": false,
      "text": "profit = mx - prices[i]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "profit = mx - prices[i]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DumYXoqunBy0rxqjYK6fE",
      "type": "text",
      "x": 309,
      "y": 4338.5,
      "width": 385,
      "height": 425,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4Yv",
      "roundness": null,
      "seed": 348510272,
      "version": 241,
      "versionNonce": 74920923,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789637596730,
      "created": 1789487494550,
      "link": null,
      "locked": false,
      "text": "ans =0 \n\n\nfor(int i = 0 ; i < n ; i++ ) :\n\n\n    // buying on ith day\n\n    \n    int mx = 0\n    for(int j = i +1 ; j <n ; j++ :\n\n        mx = max(mx,prices[j])\n\n    ans  =  max(ans,mx-prices[i])\n\nprint(ans)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ans =0 \n\n\nfor(int i = 0 ; i < n ; i++ ) :\n\n\n    // buying on ith day\n\n    \n    int mx = 0\n    for(int j = i +1 ; j <n ; j++ :\n\n        mx = max(mx,prices[j])\n\n    ans  =  max(ans,mx-prices[i])\n\nprint(ans)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
