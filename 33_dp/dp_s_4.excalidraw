      "seed": 165539515,
      "version": 222,
      "versionNonce": 617018613,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524914,
      "created": 1789665600987,
      "link": null,
      "locked": false,
      "text": "int solve(i,j) :\n\n    if i> j :\n        return 0;\n\n\n    if s[i] == s[j] :\n\n        ans = solve(i+1,j-1)\n\n    else :\n        ans1 = 1+solve(i+1,j)\n\n        ans2 = 1+solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n\n    return ans\n        ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(i,j) :\n\n    if i> j :\n        return 0;\n\n\n    if s[i] == s[j] :\n\n        ans = solve(i+1,j-1)\n\n    else :\n        ans1 = 1+solve(i+1,j)\n\n        ans2 = 1+solve(j,i+1)\n\n        ans = min(ans1,ans2)\n\n\n    return ans\n        ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
