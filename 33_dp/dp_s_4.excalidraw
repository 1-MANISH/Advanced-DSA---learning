      "text": "name: CI_PIPLINE\n\non: \n    push: \n        brnaches:[main]\n\njobs:\n    build:\n        runs-on:ubuntu-latest\n    steps:\n        -name: checkout  code\n        uses : actions/checkout@v5\n        \n        -name: set up node js\n        uses:actions/setup-node@v3\n        with:\n            node-version:16\n\n        -name: Insta;; dependecicies\n        run: npm install\n\n        -name: run tests\n        run : npm run test\n\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "name: CI_PIPLINE\n\non: \n    push: \n        brnaches:[main]\n\njobs:\n    build:\n        runs-on:ubuntu-latest\n    steps:\n        -name: checkout  code\n        uses : actions/checkout@v5\n        \n        -name: set up node js\n        uses:actions/setup-node@v3\n        with:\n            node-version:16\n\n        -name: Insta;; dependecicies\n        run: npm install\n\n        -name: run tests\n        run : npm run test\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
