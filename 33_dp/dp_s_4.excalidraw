      "seed": 863777205,
      "version": 147,
      "versionNonce": 415099029,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524914,
      "created": 1789664828374,
      "link": null,
      "locked": false,
      "text": "bool isPal(string s):\n\n    i = 0, j=n-1;\n\n    while(i<j) :\n\n        if s[i]!=s[j] return false\n        i++\n        j--;\n\n\n    return true",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool isPal(string s):\n\n    i = 0, j=n-1;\n\n    while(i<j) :\n\n        if s[i]!=s[j] return false\n        i++\n        j--;\n\n\n    return true",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
