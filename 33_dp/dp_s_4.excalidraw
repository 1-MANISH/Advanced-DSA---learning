    {
      "id": "79TGiviBsHJRYvSdWFHvJ",
      "type": "text",
      "x": 337.5,
      "y": 9254.5,
      "width": 560.4385986328125,
      "height": 943.9999999999999,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4ay",
      "roundness": null,
      "seed": 108044352,
      "version": 745,
      "versionNonce": 1951103029,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789637596731,
      "created": 1789489189988,
      "link": null,
      "locked": false,
      "text": "int** dp;\n\nint solve(int index,int trasactionType) :\n    \n    if(index==n)\n        return 0\n\n    if(dp[index][trasactionType] != -1 ) :\n        return dp[index][trasactionType]\n\n    // skip this day\n\n    ans1 = solve(index+1,trasactionType)\n\n    \n    // perform the possible transactions\n    \n    if trasactionType===BUY:\n        ans2 = -prices[index]+solve(index+1,SELL)\n    else :\n        ans2 = prices[index]// break as 1 txs\n\n    return dp[index][trasactionType] =  max(ans1,ans2)\n\n\nmain():\n\n    //input\n\n    dp = new int*[n]\n\n    for(int i =  0 ; i<n ; i++):\n        dp[i] = new int[2]\n        dp[i][0]=dp[i][1]=-1\n\n\n    \n    ans = solve(0,BUY)\n    \n",
      "fontSize": 18.88,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int** dp;\n\nint solve(int index,int trasactionType) :\n    \n    if(index==n)\n        return 0\n\n    if(dp[index][trasactionType] != -1 ) :\n        return dp[index][trasactionType]\n\n    // skip this day\n\n    ans1 = solve(index+1,trasactionType)\n\n    \n    // perform the possible transactions\n    \n    if trasactionType===BUY:\n        ans2 = -prices[index]+solve(index+1,SELL)\n    else :\n        ans2 = prices[index]// break as 1 txs\n\n    return dp[index][trasactionType] =  max(ans1,ans2)\n\n\nmain():\n\n    //input\n\n    dp = new int*[n]\n\n    for(int i =  0 ; i<n ; i++):\n        dp[i] = new int[2]\n        dp[i][0]=dp[i][1]=-1\n\n\n    \n    ans = solve(0,BUY)\n    \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
