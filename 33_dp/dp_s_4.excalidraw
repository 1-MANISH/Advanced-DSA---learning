    {
      "id": "H-hQxMy40oyMZo-JPgR0P",
      "type": "text",
      "x": 515,
      "y": 13502.5,
      "width": 473,
      "height": 500,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4g3",
      "roundness": null,
      "seed": 1337208725,
      "version": 405,
      "versionNonce": 1883771637,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524914,
      "created": 1789663291353,
      "link": null,
      "locked": false,
      "text": "int solve(i,j) :\n\n    if s1[i] != s2[j] :\n\n        // update,insert,remove - 3 options\n\n        // update\n        ans1 = 1+ solve(i+1,j+1)\n\n        // remove from s1\n        ans2 = 1+solve(i+1,j)\n        \n        // remove from s2\n        ans3 = 1+solve(i,j+1)\n\n        // insert in s1\n        ans4 = 1+solve(i,j+1)\n\n        // insert in s2\n        ans5 = 1+solve(i+1,j)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(i,j) :\n\n    if s1[i] != s2[j] :\n\n        // update,insert,remove - 3 options\n\n        // update\n        ans1 = 1+ solve(i+1,j+1)\n\n        // remove from s1\n        ans2 = 1+solve(i+1,j)\n        \n        // remove from s2\n        ans3 = 1+solve(i,j+1)\n\n        // insert in s1\n        ans4 = 1+solve(i,j+1)\n\n        // insert in s2\n        ans5 = 1+solve(i+1,j)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "V35H1NFWTtTJy9Vfl2yFn",
      "type": "text",
      "x": 510.5,
      "y": 14240,
      "width": 528,
      "height": 775,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
