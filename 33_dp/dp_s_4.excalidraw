      "updated": 1789711524913,
      "created": 1789662048635,
      "link": null,
      "locked": false,
      "text": "solve(int i , int j ,int k) :\n    \n    if(i==n1 or j==n2 or k==n3):\n        return 0\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] == s3[k] :\n\n        ans = 1 + solve(i+1,j+1,k+1)\n\n    else :\n        \n        ans1 = solve(i+1,j,k)\n\n        ans2 = solve(i,j+1,k)\n\n        ans3 = solve(i,j,k+1)\n\n        ans = max(ans1,ans2,ans3)\n\n    return ans\n        \n   \n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "solve(int i , int j ,int k) :\n    \n    if(i==n1 or j==n2 or k==n3):\n        return 0\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] == s3[k] :\n\n        ans = 1 + solve(i+1,j+1,k+1)\n\n    else :\n        \n        ans1 = solve(i+1,j,k)\n\n        ans2 = solve(i,j+1,k)\n\n        ans3 = solve(i,j,k+1)\n\n        ans = max(ans1,ans2,ans3)\n\n    return ans\n        \n   \n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
