    {
      "id": "FPSqV_Ws25MvHZhLG4OOv",
      "type": "text",
      "x": -547,
      "y": 12962.5,
      "width": 605,
      "height": 375,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c41V",
      "roundness": null,
      "seed": 1939226500,
      "version": 383,
      "versionNonce": 380270656,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789485794737,
      "link": null,
      "locked": false,
      "text": "bool f(int index,int currentSum,int totalSum) :\n\n    if(index>=n) :\n        return currentSum==totalSum-currentSum;    \n\n    // take it\n    bool a1 = f(index+1,currentSum+arr[index],totalSum)\n\n\n    // not take it\n    bool a2 = f(index+2,currentSum+0,totalSum)\n\n    return a1 or a2\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool f(int index,int currentSum,int totalSum) :\n\n    if(index>=n) :\n        return currentSum==totalSum-currentSum;    \n\n    // take it\n    bool a1 = f(index+1,currentSum+arr[index],totalSum)\n\n\n    // not take it\n    bool a2 = f(index+2,currentSum+0,totalSum)\n\n    return a1 or a2\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
