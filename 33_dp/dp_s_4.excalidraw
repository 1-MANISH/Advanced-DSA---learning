    {
      "id": "j4MuU-giyTS3POOK2Zz7_",
      "type": "text",
      "x": 359,
      "y": 12571.5,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4rb",
      "roundness": null,
      "seed": 1336517077,
      "version": 4,
      "versionNonce": 1199804245,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1790093641954,
      "created": 1790093638843,
      "link": null,
      "locked": false,
      "text": "",
