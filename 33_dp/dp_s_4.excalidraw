    {
      "id": "5uuVqzsk1rFNcqJW_tdki",
      "type": "text",
      "x": 385,
      "y": 7121.5,
      "width": 396,
      "height": 900,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4e8",
      "roundness": null,
      "seed": 1009625979,
      "version": 476,
      "versionNonce": 1028709589,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789711524913,
      "created": 1789661819855,
      "link": null,
      "locked": false,
      "text": "int dp[n][m] // -1\n\n\nsolve(int i , int j ) :\n    \n    if(i==n or j==m):\n        return 0\n\n    if(dp[i][j]!=-1) return dp[i][j]\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] :\n\n        ans = 1 + solve(i+1,j+1)\n\n    else :\n\n        ans1 = solve(i+1,j)\n\n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n    return dp[i][j] =  ans\n\n\n\nmain() :\n\n    input\n    fill(dp,-1)\n    print solve(0,0)\n        \n   \n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[n][m] // -1\n\n\nsolve(int i , int j ) :\n    \n    if(i==n or j==m):\n        return 0\n\n    if(dp[i][j]!=-1) return dp[i][j]\n\n    int ans = 0 ;\n\n    if s1[i] == s2[j] :\n\n        ans = 1 + solve(i+1,j+1)\n\n    else :\n\n        ans1 = solve(i+1,j)\n\n        ans2 = solve(i,j+1)\n\n        ans = max(ans1,ans2)\n\n    return dp[i][j] =  ans\n\n\n\nmain() :\n\n    input\n    fill(dp,-1)\n    print solve(0,0)\n        \n   \n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
