      "updated": 1789489792949,
      "created": 1789489766147,
      "link": null,
      "locked": false,
      "text": "main() :\n\n    ans  = solve(0,0)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main() :\n\n    ans  = solve(0,0)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RFXC9Ne5DrX6UzQWLVcde",
      "type": "text",
      "x": 336.5,
      "y": 10986.5,
      "width": 572,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c4bH",
      "roundness": null,
      "seed": 220098624,
      "version": 868,
      "versionNonce": 407495003,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789637596731,
      "created": 1789489790685,
      "link": null,
      "locked": false,
      "text": "int solve(int index,int event) :\n    \n    if(event == 2*k(4) or index==n)\n        return 0\n\n    // skip this day\n\n    ans1 = solve(index+1,event)\n\n    // perfoming the possible events/ transaction\n    transactionType = event%2 ==0 ? \"BUY\" :\"SELL \"\n\n    if transactionType == \"BUY\"\n        ans2 = -prices[index]+solve(index+1,event+1)\n\n    else :\n        ans2 = prices[i]+solve(index+1,event+1)\n    \n    return max(ans1,ans2)\n\nmain():\n\n    //input\n    \n    ans = solve(0,0)\n    \n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve(int index,int event) :\n    \n    if(event == 2*k(4) or index==n)\n        return 0\n\n    // skip this day\n\n    ans1 = solve(index+1,event)\n\n    // perfoming the possible events/ transaction\n    transactionType = event%2 ==0 ? \"BUY\" :\"SELL \"\n\n    if transactionType == \"BUY\"\n        ans2 = -prices[index]+solve(index+1,event+1)\n\n    else :\n        ans2 = prices[i]+solve(index+1,event+1)\n    \n    return max(ans1,ans2)\n\nmain():\n\n    //input\n    \n    ans = solve(0,0)\n    \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
