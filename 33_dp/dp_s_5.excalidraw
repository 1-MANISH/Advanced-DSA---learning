      "boundElements": null,
      "updated": 1790701852502,
      "created": 1790701798240,
      "link": null,
      "locked": false,
      "text": "A = []\n\nA[i] = {0,1,2,3}\n\n0 - must rest\n1 - contest if possible , or rest\n2 -  gym if possible or rest\n3 - G or C or R\n\ncan't perform same actity on 2 consecutive days\n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A = []\n\nA[i] = {0,1,2,3}\n\n0 - must rest\n1 - contest if possible , or rest\n2 -  gym if possible or rest\n3 - G or C or R\n\ncan't perform same actity on 2 consecutive days\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ohDKGr-lsDCaI9BQdC4Fa",
      "type": "text",
      "x": 362,
