    {
      "id": "BooB8xpXA4RUFkkMv0PZU",
      "type": "text",
      "x": 343,
      "y": 6207.5,
      "width": 495,
      "height": 650,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 1629379939,
      "version": 401,
      "versionNonce": 261901507,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790702147761,
      "created": 1790701856480,
      "link": null,
      "locked": false,
      "text": "int f(int index,int prev) :\n\n    // base case\n    \n    // always take rest\n    int ans1 = 1 + f(index+1,REST)\n\n    // CONTEST\n    int ans2 = INT_MAX/N\n\n    if(a[i]==1 or a[i]==3) and prev!=CONTEST:\n        ans1 = f(index+1,CONTEST)\n    \n    // GYM\n    int ans3 = INT_MAX/N\n     if(a[i]==2 or a[i]==3) and prev!=GYM:\n        ans1 = f(index+1,GYM)\n\n    return min(ans1,ans2,ans3)\n\n\nmain :\n\n    N,A = []\n    \n    cout << f(0,REST)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int index,int prev) :\n\n    // base case\n    \n    // always take rest\n    int ans1 = 1 + f(index+1,REST)\n\n    // CONTEST\n    int ans2 = INT_MAX/N\n\n    if(a[i]==1 or a[i]==3) and prev!=CONTEST:\n        ans1 = f(index+1,CONTEST)\n    \n    // GYM\n    int ans3 = INT_MAX/N\n     if(a[i]==2 or a[i]==3) and prev!=GYM:\n        ans1 = f(index+1,GYM)\n\n    return min(ans1,ans2,ans3)\n\n\nmain :\n\n    N,A = []\n    \n    cout << f(0,REST)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
