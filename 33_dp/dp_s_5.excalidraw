    {
      "id": "W_Q7ZcxHnFsvTZQ-4nTqD",
      "type": "text",
      "x": 292,
      "y": 2949.5,
      "width": 550,
      "height": 425,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 142467053,
      "version": 353,
      "versionNonce": 1697893933,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790698797314,
      "created": 1790698647821,
      "link": null,
      "locked": false,
      "text": "f (index  ,  currentWeight ) :\n    \n    // base case\n    if(index==n) :\n        return 0;\n    \n    not take\n    int ans1 = f(index+1,currentWeight)\n\n\n    //take it -  if possible\n    int ans2  = 0 ;\n    if( currentWeight + wts[index] < capacity) :\n        ans2 = f(index+1,currentWeight+wts[index] \n\n    return max(ans1,ans2)\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f (index  ,  currentWeight ) :\n    \n    // base case\n    if(index==n) :\n        return 0;\n    \n    not take\n    int ans1 = f(index+1,currentWeight)\n\n\n    //take it -  if possible\n    int ans2  = 0 ;\n    if( currentWeight + wts[index] < capacity) :\n        ans2 = f(index+1,currentWeight+wts[index] \n\n    return max(ans1,ans2)\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
