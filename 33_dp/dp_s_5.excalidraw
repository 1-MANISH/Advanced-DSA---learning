    {
      "id": "KJ3OHDRqtzi1JbaneZfVg",
      "type": "text",
      "x": 301,
      "y": 3614.5,
      "width": 781,
      "height": 700,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1834588493,
      "version": 584,
      "versionNonce": 1956629933,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790698938043,
      "created": 1790698836181,
      "link": null,
      "locked": false,
      "text": "int dp[N][W]\n\nf (index  ,  currentWeight ) :\n    \n    // base case\n    if(index==n) :\n        return 0;\n\n    if(dp[index][currentWeight] != -1 ) return dp[index][currentWeight]\n    \n    not take\n    int ans1 = f(index+1,currentWeight)\n\n\n    //take it -  if possible\n    int ans2  = 0 ;\n    if( currentWeight + wts[index] < capacity) :\n        ans2 = f(index+1,currentWeight+wts[index] \n\n    return dp[index][currentWeight] = max(ans1,ans2)\n\n\nint main() :\n    \n    // input\n    // memset(dp,-1,sizeof dp)\n    cout << f(0,0)\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[N][W]\n\nf (index  ,  currentWeight ) :\n    \n    // base case\n    if(index==n) :\n        return 0;\n\n    if(dp[index][currentWeight] != -1 ) return dp[index][currentWeight]\n    \n    not take\n    int ans1 = f(index+1,currentWeight)\n\n\n    //take it -  if possible\n    int ans2  = 0 ;\n    if( currentWeight + wts[index] < capacity) :\n        ans2 = f(index+1,currentWeight+wts[index] \n\n    return dp[index][currentWeight] = max(ans1,ans2)\n\n\nint main() :\n    \n    // input\n    // memset(dp,-1,sizeof dp)\n    cout << f(0,0)\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
