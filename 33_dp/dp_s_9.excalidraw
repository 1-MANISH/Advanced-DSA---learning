    {
      "id": "-BU_Ml-AT1lBFIuZFX8NN",
      "type": "text",
      "x": 560,
      "y": 2685.5,
      "width": 400.39984130859375,
      "height": 665,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "byZ",
      "roundness": null,
      "seed": 1247694935,
      "version": 314,
      "versionNonce": 1669389017,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792078892082,
      "created": 1792078686233,
      "link": null,
      "locked": false,
      "text": "f(int pos,prev) :\n\n    if(pos>N): return 0;\n\n    if (pos==N)  return 1;\n\n    // jump1\n    int a1 = f(pos+1,1)\n\n    // jump2\n    int a2 = 0;\n    if(prev!=2):\n        a2  = f(pos+2,2)\n\n    // jump 3\n    int a3 = f(pos+3,3)\n\n\n    return a1+a2+a3",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(int pos,prev) :\n\n    if(pos>N): return 0;\n\n    if (pos==N)  return 1;\n\n    // jump1\n    int a1 = f(pos+1,1)\n\n    // jump2\n    int a2 = 0;\n    if(prev!=2):\n        a2  = f(pos+2,2)\n\n    // jump 3\n    int a3 = f(pos+3,3)\n\n\n    return a1+a2+a3",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
