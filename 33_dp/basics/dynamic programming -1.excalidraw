    {
      "id": "AvAv0d2DVUCiAKIGFegXN",
      "type": "text",
      "x": 222,
      "y": 11533,
      "width": 418,
      "height": 375,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
