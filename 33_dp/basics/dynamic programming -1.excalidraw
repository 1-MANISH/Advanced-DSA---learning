      "updated": 1788769494686,
      "link": null,
      "locked": false,
      "text": "f(1) = 0 \nf(2) = 1\n\n\nf(n) = f(n-1)+f(n-2)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(1) = 0 \nf(2) = 1\n\n\nf(n) = f(n-1)+f(n-2)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
