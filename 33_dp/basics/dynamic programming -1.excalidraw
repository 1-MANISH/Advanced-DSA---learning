      "seed": 1239895996,
      "version": 670,
      "versionNonce": 40268420,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789039903430,
      "link": null,
      "locked": false,
      "text": "int f (int start ,int n,int house[]){\n    \n    if(start>n)return 0;    \n\n    int ans = INT_MIN\n\n    for(int i= start , i<=n ; i++){\n        currentAns = house[i]+f(i+2,n,house);\n        ans  = max(ans,currentAns)\n    }\n    \n    return ans;\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f (int start ,int n,int house[]){\n    \n    if(start>n)return 0;    \n\n    int ans = INT_MIN\n\n    for(int i= start , i<=n ; i++){\n        currentAns = house[i]+f(i+2,n,house);\n        ans  = max(ans,currentAns)\n    }\n    \n    return ans;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
