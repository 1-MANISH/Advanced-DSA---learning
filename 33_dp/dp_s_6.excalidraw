      "isDeleted": false,
      "boundElements": null,
      "updated": 1790874489119,
      "created": 1790874358211,
      "link": null,
      "locked": false,
      "text": "int dp[n+2]\n\nfor(int i = n ; i >= 0 ; i--) :\n    \n    int &ans = dp[i][j];\n    if(i>=n) :\n        ans = 0;\n        continue;\n\n    int ans1 = arr[i] + dp[i+2]\n\n    int ans2  dp[i+1]\n\n    ans = max(ans1,ans2)\n\n\nreturn dp[0]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[n+2]\n\nfor(int i = n ; i >= 0 ; i--) :\n    \n    int &ans = dp[i][j];\n    if(i>=n) :\n        ans = 0;\n        continue;\n\n    int ans1 = arr[i] + dp[i+2]\n\n    int ans2  dp[i+1]\n\n    ans = max(ans1,ans2)\n\n\nreturn dp[0]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
