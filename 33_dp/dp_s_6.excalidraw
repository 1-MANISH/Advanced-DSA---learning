      "isDeleted": false,
      "boundElements": null,
      "updated": 1790875329967,
      "created": 1790875135602,
      "link": null,
      "locked": false,
      "text": "int dp[n+1][maxCap+1]\n\n\nfor(int i = n  i >= 0 ; i-- ) :\n\n    for(int cap : maCap ; cap > = 0; cap--) :\n\n        int &ans = dp[i][cap];\n\n        if(i >= n) :\n            ans = 0 ;\n            continue;\n\n        int ans1 = 0 ;\n\n        if(cap+w[i] <= maxCal) :\n            ans1 = v[i] + dp[i+1][cap+w[i]]\n\n        int ans2 = dp[i+1][cap]\n\n        ans = max(ans1,ans2)\n\n\n\nreturn dp[0][0]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[n+1][maxCap+1]\n\n\nfor(int i = n  i >= 0 ; i-- ) :\n\n    for(int cap : maCap ; cap > = 0; cap--) :\n\n        int &ans = dp[i][cap];\n\n        if(i >= n) :\n            ans = 0 ;\n            continue;\n\n        int ans1 = 0 ;\n\n        if(cap+w[i] <= maxCal) :\n            ans1 = v[i] + dp[i+1][cap+w[i]]\n\n        int ans2 = dp[i+1][cap]\n\n        ans = max(ans1,ans2)\n\n\n\nreturn dp[0][0]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
