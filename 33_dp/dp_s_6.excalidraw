    {
      "id": "ONZHNfXZaRPhZj7CKPuLN",
      "type": "text",
      "x": 567,
      "y": 8706.5,
      "width": 473,
      "height": 750,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 856254322,
      "version": 589,
      "versionNonce": 1058023986,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "pyTMI6QqRdmeZ_8V8bS6D",
          "type": "arrow"
        }
      ],
      "updated": 1790874128477,
      "created": 1790873365850,
      "link": null,
      "locked": false,
      "text": "dp[n+1][m+1]; // INF\n\n\ndp[n-1][m-1]= grid[n-1][m-1]\n\nfor(int i = n ; i >= 0 ; i--) {\n    \n    for(int j = m ; j >=0 ; j--) {\n        \n        int &ans = dp[i][j];\n        \n        if(i==n-1 and j==m-1)\n             ans = grid[n-1][m-1]\n             continue\n\n        if(i>=n or j >=m )\n            ans = INF\n            continue\n\n        int ans1 = grid[i][j] + dp[i][j+1];\n\n        int ans2 = grid[i][j] + dp[i+1][j];\n\n        ans =  min(ans1,ans2)\n        \n    }\n\n} \n\nreturn dp[0][0]",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "dp[n+1][m+1]; // INF\n\n\ndp[n-1][m-1]= grid[n-1][m-1]\n\nfor(int i = n ; i >= 0 ; i--) {\n    \n    for(int j = m ; j >=0 ; j--) {\n        \n        int &ans = dp[i][j];\n        \n        if(i==n-1 and j==m-1)\n             ans = grid[n-1][m-1]\n             continue\n\n        if(i>=n or j >=m )\n            ans = INF\n            continue\n\n        int ans1 = grid[i][j] + dp[i][j+1];\n\n        int ans2 = grid[i][j] + dp[i+1][j];\n\n        ans =  min(ans1,ans2)\n        \n    }\n\n} \n\nreturn dp[0][0]",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
