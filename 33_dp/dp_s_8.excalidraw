      "link": null,
      "locked": false,
      "text": "int dp[N][N]\n\nint solve (int A[] , int idx , int prevIdx) :\n\n\n    // base case\n    if(idx==A.size()) return 0;\n\n    if(dp[idx][prevIdx]!=-1) return dp[idx][prevIdx]\n\n    // not take\n    int ans1 = sovle(A,idx+1,prevIdx);\n\n\n    // take it possible\n    int ans2 =  0;\n    if( A[idx] > A[prevIdx] )\n\n        ans2 = 1 + solve(A,idx+1,idx)\n\n\n    return dp[idx][prevIdx] = max(ans1,ans2)\n\n\nmain():\n\n    // inputs\n    int n;\n    cin >> n;\n    vector<int>A(n+1,INT_MIN)\n    for(int i = 0 ; i < n ; i++) cin >> A[i]\n    memset(dp,-1,sizeof dp)\n    cout << solve(A,0,N)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int dp[N][N]\n\nint solve (int A[] , int idx , int prevIdx) :\n\n\n    // base case\n    if(idx==A.size()) return 0;\n\n    if(dp[idx][prevIdx]!=-1) return dp[idx][prevIdx]\n\n    // not take\n    int ans1 = sovle(A,idx+1,prevIdx);\n\n\n    // take it possible\n    int ans2 =  0;\n    if( A[idx] > A[prevIdx] )\n\n        ans2 = 1 + solve(A,idx+1,idx)\n\n\n    return dp[idx][prevIdx] = max(ans1,ans2)\n\n\nmain():\n\n    // inputs\n    int n;\n    cin >> n;\n    vector<int>A(n+1,INT_MIN)\n    for(int i = 0 ; i < n ; i++) cin >> A[i]\n    memset(dp,-1,sizeof dp)\n    cout << solve(A,0,N)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
