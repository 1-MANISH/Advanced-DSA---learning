      "updated": 1791474730390,
      "created": 1791474490790,
      "link": null,
      "locked": false,
      "text": "int solve (int A[] , int idx , int prevIdx) :\n\n\n    // base case\n    if(idx==A.size()) return 0;\n\n    // not take\n\n    int ans1 = sovle(A,idx+1,prevIdx);\n\n\n    // take it possible\n    int ans2 =  0;\n    if( A[idx] > A[prevIdx] )\n\n        ans2 = 1 + solve(A,idx+1,idx)\n\n\n    return max(ans1,ans2)\n\n\nmain():\n\n    // inputs\n    vector<int>A(n+1,INT_MIN)\n    cout << solve(A,0,N)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int solve (int A[] , int idx , int prevIdx) :\n\n\n    // base case\n    if(idx==A.size()) return 0;\n\n    // not take\n\n    int ans1 = sovle(A,idx+1,prevIdx);\n\n\n    // take it possible\n    int ans2 =  0;\n    if( A[idx] > A[prevIdx] )\n\n        ans2 = 1 + solve(A,idx+1,idx)\n\n\n    return max(ans1,ans2)\n\n\nmain():\n\n    // inputs\n    vector<int>A(n+1,INT_MIN)\n    cout << solve(A,0,N)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
