      "boundElements": [],
      "updated": 1789051621631,
      "link": null,
      "locked": false,
      "text": "int f(int i , int j , int n , int  m){\n    \n    if(i>=n or j>=m)return 0 ;\n\n    if(i==n-1 && j == m-1)return 1;\n    \n    if(dp[i][j]!=-1)return dp[i][j];\n    // right\n    ans1 =  f(i,j+1,n,m)\n\n    // down\n    ans2 =  f(i+1,j,n,m)\n\n    return dp[i][j] =  ans1+ans2\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int i , int j , int n , int  m){\n    \n    if(i>=n or j>=m)return 0 ;\n\n    if(i==n-1 && j == m-1)return 1;\n    \n    if(dp[i][j]!=-1)return dp[i][j];\n    // right\n    ans1 =  f(i,j+1,n,m)\n\n    // down\n    ans2 =  f(i+1,j,n,m)\n\n    return dp[i][j] =  ans1+ans2\n}",
