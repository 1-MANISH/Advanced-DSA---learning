      "updated": 1789051621630,
      "link": null,
      "locked": false,
      "text": "int fib(int n){\n    \n    if(n==1 or n==2)return n-1;\n    \n    return fib(n-1)+fib(n-2);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int fib(int n){\n    \n    if(n==1 or n==2)return n-1;\n    \n    return fib(n-1)+fib(n-2);\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
