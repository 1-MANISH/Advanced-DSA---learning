      "text": "\n\nint f (pos,N ):\n    \n    if(path>N)\n        return 0\n    if pos==n\n        return 1\n    \n    int a1 = f(pos+1,N)\n   \n    int a2 = f(pos+2,N)\n\n    return a1+a2\n   \n\nmain ():\n\n    N = input()\n\n    print(f(0,N))\n\n    ",
      "fontSize": 20,
