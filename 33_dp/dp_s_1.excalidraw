      "link": null,
      "locked": false,
      "text": "int helper(int start ,int n , vector<int>hosue){\n\n    if(start>n)return 0;\n    \n    int ans = INT_MIN\n    for(int i = start; i <=n ; i++){\n        currentAns = house[start]+helper(i+2,n,house)\n        \n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int helper(int start ,int n , vector<int>hosue){\n\n    if(start>n)return 0;\n    \n    int ans = INT_MIN\n    for(int i = start; i <=n ; i++){\n        currentAns = house[start]+helper(i+2,n,house)\n        \n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
