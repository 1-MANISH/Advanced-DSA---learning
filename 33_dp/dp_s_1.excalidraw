    {
      "id": "WySpZKyEf2LQEzQHRdhXV",
      "type": "text",
      "x": 419,
      "y": 8674.5,
      "width": 554.3997802734375,
      "height": 665,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3q9",
      "roundness": null,
      "seed": 935671356,
      "version": 324,
      "versionNonce": 1177412028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789115561408,
      "link": null,
      "locked": false,
      "text": "int f(int idx , int n , int arr[]) :\n    \n    if(idx>=N) :\n        return 0;\n    \n    // rob this house\n    ans1 = arr[idx]+f(idx+2,n,arr)\n\n    // skip this house\n    ans2 = f(idx+1,n,arr)\n\n    return max(ans1,ans2)\n\nmain() :\n    \n    int N;\n    int arr[N]\n\n    print f(0,N,arr)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int idx , int n , int arr[]) :\n    \n    if(idx>=N) :\n        return 0;\n    \n    // rob this house\n    ans1 = arr[idx]+f(idx+2,n,arr)\n\n    // skip this house\n    ans2 = f(idx+1,n,arr)\n\n    return max(ans1,ans2)\n\nmain() :\n    \n    int N;\n    int arr[N]\n\n    print f(0,N,arr)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
