      "link": null,
      "locked": false,
      "text": "Right or Down\ncount number of ways to reach from (0,0) to (n-1,n-1)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Right or Down\ncount number of ways to reach from (0,0) to (n-1,n-1)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZSs7NVeGOlYeBuhOXi396",
      "type": "text",
      "x": 259,
      "y": 10810.5,
      "width": 418,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c307",
      "roundness": null,
      "seed": 1286115799,
      "version": 256,
      "versionNonce": 189859388,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789051621631,
      "link": null,
      "locked": false,
      "text": "int f(int i , int j , int n , int  m){\n    \n    if(i>=n or j>=m)return 0 ;\n\n    if(i==n-1 && j == m-1)return 1;\n    \n    // right\n    ans1 =  f(i,j+1,n,m)\n\n    // down\n    ans2 =  f(i+1,j,n,m)\n\n    return ans1+ans2\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(int i , int j , int n , int  m){\n    \n    if(i>=n or j>=m)return 0 ;\n\n    if(i==n-1 && j == m-1)return 1;\n    \n    // right\n    ans1 =  f(i,j+1,n,m)\n\n    // down\n    ans2 =  f(i+1,j,n,m)\n\n    return ans1+ans2\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
