      "isDeleted": true,
      "boundElements": null,
      "updated": 1789051621637,
      "link": null,
      "locked": false,
      "text": "int maxRob(vector<int>&hosue){\n    \n    int ans = INT_MIN\n    int n = house.size()\n    \n    for(int start = 1 ; start <= n ; start++){\n        ans = max(ans,helper(start,n,house))\n    }\n\n    return ans;\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int maxRob(vector<int>&hosue){\n    \n    int ans = INT_MIN\n    int n = house.size()\n    \n    for(int start = 1 ; start <= n ; start++){\n        ans = max(ans,helper(start,n,house))\n    }\n\n    return ans;\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
