      "link": null,
      "locked": false,
      "text": "f(n):\n    if n==0:\n        return 0\n    if n==1:\n        return 1\n\n    return f(n-1)+f(n-2)\n\n\nmain():\n\n    n = input()\n\n    print(f(n))",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(n):\n    if n==0:\n        return 0\n    if n==1:\n        return 1\n\n    return f(n-1)+f(n-2)\n\n\nmain():\n\n    n = input()\n\n    print(f(n))",
