      "seed": 990561724,
      "version": 335,
      "versionNonce": 16832700,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789115561408,
      "link": null,
      "locked": false,
      "text": "int path = []\nint ans = []\n\nf (pos,N ):\n\n    if(pos>N)return\n\n    if(pos==N):\n        ans.push_back(path)\n        return\n    path.push_back(1)\n    f(pos+1,N)\n    path.pop_back()\n\n    path.push_back(2)\n    f(pos+2,N)\n    path.pop_back()\n\nmain ():\n\n    N = input()\n\n    f(0,N)\n\n    print(ans.size())",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int path = []\nint ans = []\n\nf (pos,N ):\n\n    if(pos>N)return\n\n    if(pos==N):\n        ans.push_back(path)\n        return\n    path.push_back(1)\n    f(pos+1,N)\n    path.pop_back()\n\n    path.push_back(2)\n    f(pos+2,N)\n    path.pop_back()\n\nmain ():\n\n    N = input()\n\n    f(0,N)\n\n    print(ans.size())",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
