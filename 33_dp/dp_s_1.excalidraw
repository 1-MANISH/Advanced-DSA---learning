      "isDeleted": true,
      "boundElements": [],
      "updated": 1789051621631,
      "link": null,
      "locked": false,
      "text": "int f(pos){\n    \n\n    if(pos==n)return 0\n\n    // jump of 1\n    \n    ans1 = cost[pos+1]+f(pos+1)\n\n    // jump of 2\n    ans2 = INT_MAX;\n    if(pos+2<=n)\n        ans2 = cost[pos+2]+f(pos+2)\n\n    return min(ans1,ans2)\n\n\n}\n\nmain(){\n\n\ncout << f(0)\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int f(pos){\n    \n\n    if(pos==n)return 0\n\n    // jump of 1\n    \n    ans1 = cost[pos+1]+f(pos+1)\n\n    // jump of 2\n    ans2 = INT_MAX;\n    if(pos+2<=n)\n        ans2 = cost[pos+2]+f(pos+2)\n\n    return min(ans1,ans2)\n\n\n}\n\nmain(){\n\n\ncout << f(0)\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
