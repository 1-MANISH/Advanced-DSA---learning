    {
      "id": "lKdMmZActT_GbooFXit37",
      "type": "text",
      "x": 427,
      "y": 14737,
      "width": 594,
      "height": 550,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3rK",
      "roundness": null,
      "seed": 318046852,
      "version": 466,
      "versionNonce": 635393084,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789115561408,
      "link": null,
      "locked": false,
      "text": "f(int idx ,  int currentW):\n    \n    if(idx>=n):\n        return 0\n\n    // take it\n    if(currentW+weight[idx]<=capacity)\n        ans1 = profit[idx]+f(idx,currentW+weight[idx])\n\n    // not take it\n\n    ans2 = f(idx+1,currentW)\n\n    return max(ans1,ans2)\n\nmain() :\n\n    int n , capacity \n    int weight[n]\n    int profit[n]\n\n    print f(idx,wConsumed)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(int idx ,  int currentW):\n    \n    if(idx>=n):\n        return 0\n\n    // take it\n    if(currentW+weight[idx]<=capacity)\n        ans1 = profit[idx]+f(idx,currentW+weight[idx])\n\n    // not take it\n\n    ans2 = f(idx+1,currentW)\n\n    return max(ans1,ans2)\n\nmain() :\n\n    int n , capacity \n    int weight[n]\n    int profit[n]\n\n    print f(idx,wConsumed)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
