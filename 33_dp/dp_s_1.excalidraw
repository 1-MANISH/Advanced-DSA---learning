    {
      "id": "n_qnmntchBCxmWcQRmmgP",
      "type": "text",
      "x": 408,
      "y": 12247,
      "width": 616,
      "height": 675,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3qs",
      "roundness": null,
      "seed": 1292838716,
      "version": 584,
      "versionNonce": 1940056252,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789115561408,
      "link": null,
      "locked": false,
      "text": "f(int idx ,  int currentW):\n    \n    if(idx>=n):\n        return 0\n\n    if(dp[idx][currentW] != -1] ) :\n        return dp[idx][currentW]\n\n    // take it\n    int ans1 = 0\n    if(currentW+weight[idx]<=capacity)\n        ans1 = profit[idx]+f(idx+1,currentW+weight[idx])\n\n    // not take it\n\n    ans2 = f(idx+1,currentW)\n\n    return dp[idx][currentW]  = max(ans1,ans2)\n\nmain() :\n\n    int n , capacity \n    int weight[n]\n    int profit[n]\n    \n    dp[n][capacity +1] // fill it -1\n    print f(idx,wConsumed)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(int idx ,  int currentW):\n    \n    if(idx>=n):\n        return 0\n\n    if(dp[idx][currentW] != -1] ) :\n        return dp[idx][currentW]\n\n    // take it\n    int ans1 = 0\n    if(currentW+weight[idx]<=capacity)\n        ans1 = profit[idx]+f(idx+1,currentW+weight[idx])\n\n    // not take it\n\n    ans2 = f(idx+1,currentW)\n\n    return dp[idx][currentW]  = max(ans1,ans2)\n\nmain() :\n\n    int n , capacity \n    int weight[n]\n    int profit[n]\n    \n    dp[n][capacity +1] // fill it -1\n    print f(idx,wConsumed)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
