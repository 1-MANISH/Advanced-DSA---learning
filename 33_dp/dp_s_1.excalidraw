    {
      "id": "2VZof7lRbCPiWdsE-pw3p",
      "type": "text",
      "x": 361.80010986328125,
      "y": 9512.5,
      "width": 418.39978027343733,
      "height": 675,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c3qC",
      "roundness": null,
      "seed": 457345796,
      "version": 773,
      "versionNonce": 701204356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789115561408,
      "link": null,
      "locked": false,
      "text": "int *dp;\n\nint f(int idx , int n , int arr[]) :\n    \n    if(idx>=N) :\n        return 0;\n    \n    if(dp[idx]!=-1):\n        return dp[idx]\n\n    // rob this house\n    ans1 = arr[idx]+f(idx+2,n,arr)\n\n    // skip this house\n    ans2 = f(idx+1,n,arr)\n\n    return dp[idx] =  max(ans1,ans2)\n\nmain() :\n    \n    int N;\n    int arr[N]\n    dp = new int[N+1]\n\n    memset(dp,-1,sizeof(dp))\n\n    print f(0,N,arr)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int *dp;\n\nint f(int idx , int n , int arr[]) :\n    \n    if(idx>=N) :\n        return 0;\n    \n    if(dp[idx]!=-1):\n        return dp[idx]\n\n    // rob this house\n    ans1 = arr[idx]+f(idx+2,n,arr)\n\n    // skip this house\n    ans2 = f(idx+1,n,arr)\n\n    return dp[idx] =  max(ans1,ans2)\n\nmain() :\n    \n    int N;\n    int arr[N]\n    dp = new int[N+1]\n\n    memset(dp,-1,sizeof(dp))\n\n    print f(0,N,arr)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
