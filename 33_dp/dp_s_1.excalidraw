    {
      "id": "QEbrEUVPUpHhH0LZCUnoa",
      "type": "text",
      "x": 417,
      "y": 15542.5,
      "width": 594,
      "height": 675,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
