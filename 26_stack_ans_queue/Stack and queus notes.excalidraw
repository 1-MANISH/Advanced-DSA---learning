      ],
      "updated": 1783445060315,
      "link": null,
      "locked": false,
      "text": "for( i = 1 ; i <= N; i++)\n{\n\n     h = h[i]\n     w = 1\n\n     int j = i-1;\n     //expand left\n     while(j>=0 && a[j]>=h)\n     {\n         w++;\n         j--\n     }\n     //expand right\n     j = i+1\n     while(j<=n && a[j]>=h)\n     {\n        w++;\n        j--\n     }\n    mx = max(mx,w*h)\n\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for( i = 1 ; i <= N; i++)\n{\n\n     h = h[i]\n     w = 1\n\n     int j = i-1;\n     //expand left\n     while(j>=0 && a[j]>=h)\n     {\n         w++;\n         j--\n     }\n     //expand right\n     j = i+1\n     while(j<=n && a[j]>=h)\n     {\n        w++;\n        j--\n     }\n    mx = max(mx,w*h)\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
