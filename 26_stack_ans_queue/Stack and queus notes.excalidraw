      "boundElements": [],
      "updated": 1783441325861,
      "link": null,
      "locked": false,
      "text": "stack <pair < element ,  element_index >> st;\nvector<int>output(n,-1)\nfor i = 0 ; i < n ; i++ {\n    if(st.empty()) push {a[i],i}\n    else{\n        if (st.top() >= a[i] ) push {a[i],i}\n        else{\n            while(!st.empty() && st.top() < a[i]) {\n                output[st.top().second] =a[i]\n                st.pop()\n            }\n            push ({a[i],i})\n        }\n    }\n}\nfor(auto &ele:output) print (ele==-1:X:ele)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "stack <pair < element ,  element_index >> st;\nvector<int>output(n,-1)\nfor i = 0 ; i < n ; i++ {\n    if(st.empty()) push {a[i],i}\n    else{\n        if (st.top() >= a[i] ) push {a[i],i}\n        else{\n            while(!st.empty() && st.top() < a[i]) {\n                output[st.top().second] =a[i]\n                st.pop()\n            }\n            push ({a[i],i})\n        }\n    }\n}\nfor(auto &ele:output) print (ele==-1:X:ele)",
      "autoResize": true,
      "lineHeight": 1.25
    },
