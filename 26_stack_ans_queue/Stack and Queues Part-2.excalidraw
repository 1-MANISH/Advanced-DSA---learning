      "link": null,
      "locked": false,
      "text": "int N = 100\n\nqueue<int>q;\nq.push(0)\n\nwhile(q.empty()) {\n    \n        int digit = q.front();\n        print(digit);\n        q.pop();\n        for(int &ele:good){\n              a = digit*10+ele;\n              if(a<=N) q.push(a)\n        }       \n    \n    \n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int N = 100\n\nqueue<int>q;\nq.push(0)\n\nwhile(q.empty()) {\n    \n        int digit = q.front();\n        print(digit);\n        q.pop();\n        for(int &ele:good){\n              a = digit*10+ele;\n              if(a<=N) q.push(a)\n        }       \n    \n    \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
