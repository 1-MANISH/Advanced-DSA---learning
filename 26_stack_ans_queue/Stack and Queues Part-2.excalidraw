      "link": null,
      "locked": false,
      "text": "class Node{\n    int value;\n    Node* next;\n    \n    Node(value){this->value=value,this->next=NULL;}\n};\n\nclass LinkedList{\n    Node* head,*tail;\n    int _size=0;\n\n    LinkedList(){\n\n        head=tail=NULL;\n        _size=0;\n    }\n\n    insertAtTail(int x){\n        \n    }\n\n    deleteAtHead(){\n\n\n    }\n    size(){\n        return size;\n    }\n\n};\n\nclass MyQueue{\n    LinkedList *ll;\n\n    void push()\n    void pop()\n    int peek()\n    int back()\n    bool empty()\n    int size()\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Node{\n    int value;\n    Node* next;\n    \n    Node(value){this->value=value,this->next=NULL;}\n};\n\nclass LinkedList{\n    Node* head,*tail;\n    int _size=0;\n\n    LinkedList(){\n\n        head=tail=NULL;\n        _size=0;\n    }\n\n    insertAtTail(int x){\n        \n    }\n\n    deleteAtHead(){\n\n\n    }\n    size(){\n        return size;\n    }\n\n};\n\nclass MyQueue{\n    LinkedList *ll;\n\n    void push()\n    void pop()\n    int peek()\n    int back()\n    bool empty()\n    int size()\n};",
      "autoResize": true,
      "lineHeight": 1.25
