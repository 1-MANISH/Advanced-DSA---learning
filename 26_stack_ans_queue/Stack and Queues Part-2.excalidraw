    {
      "id": "7nnkUcN-SggCyeHhvw0r0",
      "type": "text",
      "x": 204,
      "y": 8565.5,
      "width": 451,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
