      "versionNonce": 486368176,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783845514483,
      "link": null,
      "locked": false,
      "text": "int N = 100\n\nqueue<int>q;\nq.push(0)\n\nwhile(q.empty()) {\n    \n        int digit = q.front();\n        print(digit);\n        q.pop();\n        int p,q;\n        a = digit*10+1 ,b = digit*10+2;\n        if(a<=N)q.push(a);\n        if(b<=N)q.push(b);\n    \n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int N = 100\n\nqueue<int>q;\nq.push(0)\n\nwhile(q.empty()) {\n    \n        int digit = q.front();\n        print(digit);\n        q.pop();\n        int p,q;\n        a = digit*10+1 ,b = digit*10+2;\n        if(a<=N)q.push(a);\n        if(b<=N)q.push(b);\n    \n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
