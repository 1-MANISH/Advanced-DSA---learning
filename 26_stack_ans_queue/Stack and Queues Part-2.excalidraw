    {
      "id": "NuvrEhtr2eC44R-UA36_F",
      "type": "text",
      "x": 247,
      "y": 3697.5,
      "width": 472,
      "height": 1100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bB6",
      "roundness": null,
      "seed": 347196240,
      "version": 763,
      "versionNonce": 535470416,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783843322980,
      "link": null,
      "locked": false,
      "text": "int max_size = 1e5\n\nclass Queue{\n    int arr[max_size]\n    int s = -1,e-1,_size=0;\n    \n    void push(int ele){\n        if(_size==max_size)return;\n        if(_size==0){\n            s=e=0;\n        }else\n        {\n            e = (e+1)%max_size;\n        }\n        arr[e]=ele\n        _size++\n    }\n\n    void pop(){\n        \n        if(_size==0)return;\n        s = (s+1)%max_size;\n        _size--;\n    }\n\n    void front(){\n        if(empty())return -1;\n        return arr[s];\n    }\n   \n    void back(){\n        if(empty())return -1;\n        return arr[e];\n    }\n\n    void size(){\n        return size;\n    }\n\n    void empty(){\n        return size==0;\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int max_size = 1e5\n\nclass Queue{\n    int arr[max_size]\n    int s = -1,e-1,_size=0;\n    \n    void push(int ele){\n        if(_size==max_size)return;\n        if(_size==0){\n            s=e=0;\n        }else\n        {\n            e = (e+1)%max_size;\n        }\n        arr[e]=ele\n        _size++\n    }\n\n    void pop(){\n        \n        if(_size==0)return;\n        s = (s+1)%max_size;\n        _size--;\n    }\n\n    void front(){\n        if(empty())return -1;\n        return arr[s];\n    }\n   \n    void back(){\n        if(empty())return -1;\n        return arr[e];\n    }\n\n    void size(){\n        return size;\n    }\n\n    void empty(){\n        return size==0;\n    }\n\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
