      "isDeleted": false,
      "boundElements": null,
      "updated": 1783844762332,
      "link": null,
      "locked": false,
      "text": "Brute force\n\nfor(int i = 1 ; i <= N ; i++){\n\n    if(good(i)) print(i)\n\n}\n\nbool good(int x){\n\n    while(x!=0){\n        int l_d = x%10;\n        if(ld!=1 && ld !=2) return false;\n        x/=10;\n    }\n    return true\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Brute force\n\nfor(int i = 1 ; i <= N ; i++){\n\n    if(good(i)) print(i)\n\n}\n\nbool good(int x){\n\n    while(x!=0){\n        int l_d = x%10;\n        if(ld!=1 && ld !=2) return false;\n        x/=10;\n    }\n    return true\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
