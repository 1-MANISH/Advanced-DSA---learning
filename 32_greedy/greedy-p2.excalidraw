      "link": null,
      "locked": false,
      "text": "\n\n\nsort(movies.begin(),movies.end(),comp) // endTime\nint index=1,\nint endTime = movies[0].endPoint\nint canWatch = 1\nwhile(index<n){\n    if(movies[index].startTime>=endPoint){\n        endTime  = movies[index].endTime\n        index++;\n        canWatch++;\n    }else{\n        index++;\n    }\n}\nreturn canWatch",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\nsort(movies.begin(),movies.end(),comp) // endTime\nint index=1,\nint endTime = movies[0].endPoint\nint canWatch = 1\nwhile(index<n){\n    if(movies[index].startTime>=endPoint){\n        endTime  = movies[index].endTime\n        index++;\n        canWatch++;\n    }else{\n        index++;\n    }\n}\nreturn canWatch",
      "autoResize": true,
      "lineHeight": 1.25
    },
