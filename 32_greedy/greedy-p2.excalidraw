      "roundness": null,
      "seed": 409979458,
      "version": 325,
      "versionNonce": 1126449758,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788518663043,
      "link": null,
      "locked": false,
      "text": "while(index<n){\n    int farthestPossible = -1;\n    while(index<n and clips[index][0]<=endPoint){\n        farthestPossible = max(farthestPossible ,clips[index][1]\n        index++\n    }\n    if(farthestPossible==-1 or farthestPossible<time)return -1;\n    endPoint = farthestPossible\n    count++;    \n    index++;\n}\n\nif(endPoint<time)return -1;\nreturn count",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while(index<n){\n    int farthestPossible = -1;\n    while(index<n and clips[index][0]<=endPoint){\n        farthestPossible = max(farthestPossible ,clips[index][1]\n        index++\n    }\n    if(farthestPossible==-1 or farthestPossible<time)return -1;\n    endPoint = farthestPossible\n    count++;    \n    index++;\n}\n\nif(endPoint<time)return -1;\nreturn count",
      "autoResize": true,
      "lineHeight": 1.25
    },
