    {
      "id": "zILy1S0cYUdb4Q-59X3VX",
      "type": "text",
      "x": 817.4444444444446,
      "y": 60308.2777777777,
      "width": 528,
      "height": 550,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c2tA",
      "roundness": null,
      "seed": 1445778206,
      "version": 526,
      "versionNonce": 1103701634,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788619217154,
      "link": null,
      "locked": false,
      "text": "void solve(vector<int>&arr,int index,bool &ans){\n\n    if(index==arr.size()-1){\n        ans=true\n        return\n    }\n    \n    if(ans)return;\n    \n    for(int i = 1; i < arr[index] ; i++){\n        \n        int canBeThere = index+i;\n        \n        if(canBeThere<arr.size()){\n            solve(arr,canBeThere,ans);\n            if(ans)return;\n        }else break;\n    }\n\n   \n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void solve(vector<int>&arr,int index,bool &ans){\n\n    if(index==arr.size()-1){\n        ans=true\n        return\n    }\n    \n    if(ans)return;\n    \n    for(int i = 1; i < arr[index] ; i++){\n        \n        int canBeThere = index+i;\n        \n        if(canBeThere<arr.size()){\n            solve(arr,canBeThere,ans);\n            if(ans)return;\n        }else break;\n    }\n\n   \n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
