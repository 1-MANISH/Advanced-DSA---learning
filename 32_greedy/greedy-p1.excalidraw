      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1Ox",
      "roundness": null,
      "seed": 1943219497,
      "version": 413,
      "versionNonce": 315871367,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787849772856,
      "link": null,
      "locked": false,
      "text": "sort\nint i = 0 , j  = 1;\nvector<int>temp = a[0];\nwhile(j<n){\n    \n    int l1 = temp[0] , r1 = temp[1]\n    int r1 = a[j][0] , r2 = a[j][1]\n\n    if(max(l1,l2) <= min(r1,r2)){\n        temp[1]=max(r1,r2)\n        j++;\n    }else{\n        cout << temp[0] << \" \" << temp[1] << endl;\n        temp = a[j]\n        i=j;\n        j++;\n    }\n}\n\ncout << temp[0] << \" \" << temp[1] << endl;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sort\nint i = 0 , j  = 1;\nvector<int>temp = a[0];\nwhile(j<n){\n    \n    int l1 = temp[0] , r1 = temp[1]\n    int r1 = a[j][0] , r2 = a[j][1]\n\n    if(max(l1,l2) <= min(r1,r2)){\n        temp[1]=max(r1,r2)\n        j++;\n    }else{\n        cout << temp[0] << \" \" << temp[1] << endl;\n        temp = a[j]\n        i=j;\n        j++;\n    }\n}\n\ncout << temp[0] << \" \" << temp[1] << endl;",
      "autoResize": true,
      "lineHeight": 1.25
    },
