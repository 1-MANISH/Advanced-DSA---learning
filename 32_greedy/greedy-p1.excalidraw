    {
      "id": "UHIc016_N4Ef-2BTjuX-u",
      "type": "text",
      "x": 381,
      "y": 16903.5,
      "width": 550,
      "height": 500,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
