      "boundElements": null,
      "updated": 1787851113651,
      "link": null,
      "locked": false,
      "text": "int i = 0 , j =i+1 ; \n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int i = 0 , j =i+1 ; \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "856VxiLPaWCIrJYSjD9Vz",
      "type": "text",
      "x": 388,
      "y": 20240,
      "width": 385,
      "height": 450,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c1PH",
      "roundness": null,
      "seed": 2110584905,
      "version": 503,
      "versionNonce": 714931561,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787851149185,
      "link": null,
      "locked": false,
      "text": "sort\nint i = 0 , j  = 1;\nvector<int>temp = a[0];\nwhile(j<n){\n    \n    int l1 = temp[0] , r1 = temp[1]\n    int r1 = a[j][0] , r2 = a[j][1]\n\n    if(max(l1,l2) <= min(r1,r2)){\n        return false;\n    }else{\n        temp = a[j]\n        i=j;\n        j++;\n    }\n}\n\nreturn true",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sort\nint i = 0 , j  = 1;\nvector<int>temp = a[0];\nwhile(j<n){\n    \n    int l1 = temp[0] , r1 = temp[1]\n    int r1 = a[j][0] , r2 = a[j][1]\n\n    if(max(l1,l2) <= min(r1,r2)){\n        return false;\n    }else{\n        temp = a[j]\n        i=j;\n        j++;\n    }\n}\n\nreturn true",
      "autoResize": true,
      "lineHeight": 1.25
    },
