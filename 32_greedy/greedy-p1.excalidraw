      "updated": 1787848308461,
      "link": null,
      "locked": false,
      "text": "remaining = capacity\n\nans  = 0\n\nfor(int i = 0 ; i < n ; i++){\n\n    if(a[i].wt <=remaminig){\n        remaminig-=a[i].wt\n        ans+=a[i].val\n    }else{\n        ans+=remaining * (a[i].val/a[i].wt)\n        break\n    }\n}\n\nreturn ans;",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "remaining = capacity\n\nans  = 0\n\nfor(int i = 0 ; i < n ; i++){\n\n    if(a[i].wt <=remaminig){\n        remaminig-=a[i].wt\n        ans+=a[i].val\n    }else{\n        ans+=remaining * (a[i].val/a[i].wt)\n        break\n    }\n}\n\nreturn ans;",
      "autoResize": true,
      "lineHeight": 1.25
    },
