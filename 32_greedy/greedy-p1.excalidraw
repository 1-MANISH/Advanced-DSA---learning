      "seed": 1913791433,
      "version": 295,
      "versionNonce": 1042507783,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787847205119,
      "link": null,
      "locked": false,
      "text": "sort(arr)\n\nint i = 0 , j = n-1 , capacity=given , ans = 0\n\nwhile(i<j){\n    if(arr[i]+arr[j]<=capacity){\n        i++;\n        j--;\n    }else{\n        j--;\n    }\n    ans++;\n}\nif(i==j)ans++;\n\nreturn ans\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sort(arr)\n\nint i = 0 , j = n-1 , capacity=given , ans = 0\n\nwhile(i<j){\n    if(arr[i]+arr[j]<=capacity){\n        i++;\n        j--;\n    }else{\n        j--;\n    }\n    ans++;\n}\nif(i==j)ans++;\n\nreturn ans\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
